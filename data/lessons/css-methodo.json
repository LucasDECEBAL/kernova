                  "Texte courant",
                  "4,5:1"
                ],
                [
                  "Grand texte",
                  "3:1"
                ],
                [
                  "Composant et focus",
                  "3:1"
                ]
              ]
            },
            {
              "type": "warning",
              "text": "Un état « erreur » rouge sans texte ni icône est invisible pour une partie des utilisateurs : ajoutez un symbole et un message."
            }
          ],
          "exercise": {
            "title": "Vérifier",
            "instructions": "Quel contraste minimal pour du texte courant ?",
            "hints": [
