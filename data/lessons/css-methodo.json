        {
          "id": "cssm-04",
          "title": "Design systems",
          "duration": 20,
          "objectives": [
            "Définir des jetons",
            "Documenter les composants",
            "Versionner les changements"
          ],
          "content": [
            {
              "type": "p",
              "text": "Un design system centralise jetons (couleurs, espacements, typographie) et composants documentés, avec des états et des règles d'usage."
            },
            {
              "type": "code",
              "lang": "css",
              "code": ":root {\n  --s1: 4px; --s2: 8px; --s3: 12px;\n  --text-sm: 0.9375rem;\n  --action: #1e4fd0;\n}",
              "title": "Jetons"
            },
            {
              "type": "tip",
              "text": "Un composant sans état documenté (survol, focus, erreur, désactivé) sera mal utilisé : documentez les états avec le composant."
            }
          ],
          "exercise": {
            "title": "Centraliser",
            "instructions": "Qu'est-ce qu'un jeton de design ?",
            "hints": [
              "Une valeur nommée réutilisable."
            ],
            "solution": "Une valeur nommée (couleur, espace, taille) partagée par les composants.",
            "check": {
