        {
          "id": "cssm-01",
          "title": "Méthodologie BEM",
          "duration": 20,
          "objectives": [
            "Nommer un bloc",
            "Déclarer un élément",
            "Gérer les modificateurs"
          ],
          "content": [
            {
              "type": "p",
              "text": "BEM nomme les classes en bloc__élément--modificateur. Le nom décrit la structure et évite les sélecteurs profonds."
            },
            {
              "type": "code",
              "lang": "css",
              "code": ".carte { }\n.carte__titre { }\n.carte__action { }\n.carte--mise-en-avant { }",
              "title": "Convention BEM"
            },
            {
              "type": "warning",
              "text": "BEM ne remplace pas une bonne structure HTML : il documente les composants, il ne corrige pas un mauvais découpage."
            }
          ],
          "exercise": {
            "title": "Nommer un élément",
            "instructions": "Comment nommer le titre à l'intérieur du bloc carte en BEM ?",
            "hints": [
              "Deux underscores."
            ],
            "solution": "carte__titre",
            "check": {
              "type": "keywords",
              "keywords": [
                "carte__titre"
              ],
              "success": "Correct : carte__titre."
            }
          },
          "quiz": [
            {
              "question": "Que sépare __ ?",
              "options": [
                "Le bloc et son élément",
                "Deux blocs",
                "Deux pages",
                "Deux fichiers"
              ],
              "answer": 0,
              "explanation": "C'est la convention élément.",
              "type": "single",
              "difficulty": 1,
              "hints": [],
              "id": "cssm-01-q1"
            },
            {
              "question": "Que fait -- ?",
              "options": [
                "Il déclare un modificateur",
                "Il crée un élément",
                "Il commente",
                "Il importe"
              ],
              "answer": 0,
              "explanation": "Le modificateur change une variante.",
              "type": "single",
              "difficulty": 1,
              "hints": [],
              "id": "cssm-01-q2"
            }
          ],
          "summary": [
            "BEM = bloc__élément--modificateur.",
            "Noms plats.",
            "Structure d'abord."
          ],
          "nextStep": "Chapitre suivant : « Optimiser les performances CSS »."
        },
        {
          "id": "cssm-02",
          "title": "Optimiser les performances CSS",
          "duration": 20,
          "objectives": [
