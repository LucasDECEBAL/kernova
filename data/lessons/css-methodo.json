        {
          "id": "cssm-03",
          "title": "Accessibilité visuelle",
          "duration": 20,
          "objectives": [
            "Garantir le contraste",
            "Ne pas dépendre de la couleur",
            "Agrandir sans casser"
          ],
          "content": [
            {
              "type": "p",
              "text": "Un texte doit atteindre 4,5:1 de contraste (3:1 pour les grands textes). L'information ne doit pas reposer sur la couleur seule."
            },
            {
              "type": "table",
              "headers": [
