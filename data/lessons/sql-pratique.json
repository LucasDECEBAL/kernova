              "answer": 0,
              "explanation": "La moyenne est calculée.",
              "type": "single",
              "difficulty": 1,
              "hints": [],
              "id": "sqlp-04-q1"
            },
            {
              "question": "Les NULL sont-ils comptés par COUNT(*) ?",
              "options": [
                "Oui, la ligne existe",
                "Non",
                "Parfois",
                "Jamais"
              ],
              "answer": 0,
              "explanation": "COUNT(*) compte les lignes.",
              "type": "single",
              "difficulty": 1,
              "hints": [],
              "id": "sqlp-04-q2"
            }
          ],
          "summary": [
