        {
          "id": "sqlp-05",
          "title": "GROUP BY",
          "duration": 20,
          "objectives": [
            "Regrouper",
            "Agréger par groupe",
            "Éviter les erreurs"
          ],
          "content": [
            {
              "type": "p",
              "text": "GROUP BY forme des groupes ; les colonnes sélectionnées doivent être agrégées ou présentes dans le groupe."
            },
            {
              "type": "code",
              "lang": "sql",
              "code": "SELECT client_id, COUNT(*) AS nb\nFROM commandes\nGROUP BY client_id;",
              "title": "Groupement"
            }
          ],
          "exercise": {
            "title": "Regrouper",
            "instructions": "Comptez les commandes par client_id.",
            "hints": [
              "GROUP BY."
            ],
            "solution": "SELECT client_id, COUNT(*) FROM commandes GROUP BY client_id;",
            "check": {
              "type": "keywords",
              "keywords": [
                "group by",
                "count"
              ],
              "success": "Correct : GROUP BY."
            }
          },
