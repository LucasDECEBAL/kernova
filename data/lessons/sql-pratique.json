        {
          "id": "sqlp-04",
          "title": "Fonctions d'agrégation",
          "duration": 20,
          "objectives": [
            "Compter et sommer",
            "Calculer une moyenne",
            "Gérer NULL"
          ],
          "content": [
            {
              "type": "p",
              "text": "COUNT, SUM, AVG, MIN, MAX agrègent plusieurs lignes ; les NULL sont ignorés par la plupart."
            },
            {
              "type": "code",
              "lang": "sql",
              "code": "SELECT COUNT(*) AS total, AVG(montant) AS moyenne FROM commandes;",
              "title": "Agrégats"
            }
          ],
          "exercise": {
            "title": "Compter",
            "instructions": "Comptez les lignes de commandes.",
            "hints": [
              "Un agrégat."
            ],
            "solution": "SELECT COUNT(*) FROM commandes;",
            "check": {
              "type": "keywords",
              "keywords": [
                "count"
              ],
              "success": "Correct : COUNT."
            }
          },
          "quiz": [
            {
              "question": "Que fait AVG ?",
              "options": [
                "La moyenne",
                "La somme",
                "Le minimum",
                "Le nombre"
