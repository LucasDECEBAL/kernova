            ],
            "solution": "DELETE FROM commandes WHERE statut = 'annulee';",
            "check": {
              "type": "keywords",
              "keywords": [
                "delete",
                "where"
              ],
              "success": "Correct : DELETE ciblé."
            }
          },
          "quiz": [
