        {
          "id": "sqlp-02",
          "title": "UPDATE",
          "duration": 20,
          "objectives": [
            "Modifier des lignes",
            "Cibler avec WHERE",
            "Vérifier avant"
          ],
          "content": [
            {
              "type": "p",
              "text": "UPDATE modifie les lignes correspondant à WHERE ; sans WHERE, toute la table est touchée."
            },
            {
              "type": "code",
              "lang": "sql",
              "code": "UPDATE clients SET email = 'nouveau@example.fr' WHERE id = 7;",
              "title": "Mise à jour"
            }
          ],
          "exercise": {
            "title": "Modifier",
            "instructions": "Passez le prix du produit 7 à 19.90.",
            "hints": [
              "UPDATE et WHERE."
            ],
            "solution": "UPDATE produits SET prix = 19.90 WHERE id = 7;",
            "check": {
              "type": "keywords",
              "keywords": [
                "update",
                "where"
              ],
              "success": "Correct : UPDATE ciblé."
            }
          },
          "quiz": [
            {
              "question": "Que fait UPDATE sans WHERE ?",
              "options": [
                "Il modifie toutes les lignes",
                "Rien",
                "Il supprime",
                "Il crée"
              ],
              "answer": 0,
              "explanation": "Toute la table est concernée.",
              "type": "single",
              "difficulty": 1,
              "hints": [],
              "id": "sqlp-02-q1"
            },
            {
              "question": "Comment vérifier avant ?",
              "options": [
                "Avec SELECT",
                "Avec DELETE",
                "Avec DROP",
                "Avec COMMIT"
