            "Cibler",
            "Préférer la désactivation"
          ],
          "content": [
            {
              "type": "p",
              "text": "DELETE supprime des lignes ; TRUNCATE vide la table entière. Les clés étrangères peuvent bloquer."
            },
            {
              "type": "code",
              "lang": "sql",
              "code": "DELETE FROM commandes WHERE statut = 'annulee';",
              "title": "Suppression"
            }
          ],
          "exercise": {
            "title": "Supprimer",
