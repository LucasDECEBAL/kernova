            {
              "type": "code",
              "lang": "text",
              "code": "src/\n├── main.c\n├── carnet.c\n└── carnet.h\nMakefile",
              "title": "Arborescence"
            },
            {
              "type": "tip",
              "text": "Un en-tête ne définit pas de variables globales : il déclare avec extern pour éviter les doublons de symbole."
            }
          ],
