        {
          "id": "cpr-03",
          "title": "Gestion de la mémoire",
          "duration": 20,
          "objectives": [
            "Reconnaître une fuite",
            "Utiliser un sanitizer",
            "Corriger un double free"
          ],
          "content": [
            {
              "type": "p",
              "text": "Une fuite survient quand une allocation n'est jamais libérée ; un double free libère deux fois. Les sanitizers détectent ces erreurs."
            },
            {
              "type": "code",
              "lang": "bash",
              "code": "gcc -fsanitize=address,undefined -g -o app main.c\n./app",
              "title": "ASan"
            },
            {
              "type": "warning",
              "text": "Un accès après free est un comportement indéfini : le pointeur ne doit plus être utilisé."
            }
          ],
          "exercise": {
            "title": "Détecter",
            "instructions": "Quelle option gcc détecte les fuites et accès invalides ?",
            "hints": [
              "Un sanitizer."
            ],
            "solution": "-fsanitize=address",
            "check": {
              "type": "keywords",
              "keywords": [
                "sanitize"
              ],
              "success": "Correct : sanitize."
            }
          },
          "quiz": [
            {
              "question": "Qu'est-ce qu'une fuite ?",
              "options": [
                "Une allocation jamais libérée",
                "Un fichier vide",
                "Une erreur de type",
                "Un pointeur nul"
              ],
              "answer": 0,
              "explanation": "La mémoire reste occupée.",
              "type": "single",
              "difficulty": 1,
              "hints": [],
