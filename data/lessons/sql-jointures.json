        {
          "id": "sqlj-01",
          "title": "HAVING",
          "duration": 20,
          "objectives": [
            "Filtrer après regroupement",
            "Comparer avec WHERE",
            "Éviter les confusions"
          ],
          "content": [
            {
              "type": "p",
              "text": "WHERE filtre les lignes avant le regroupement ; HAVING filtre les groupes après."
            },
            {
              "type": "code",
              "lang": "sql",
              "code": "SELECT client_id, COUNT(*) AS nb\nFROM commandes\nGROUP BY client_id\nHAVING COUNT(*) > 2;",
              "title": "HAVING"
            }
          ],
          "exercise": {
            "title": "Filtrer",
            "instructions": "Gardez les clients avec plus de 2 commandes.",
            "hints": [
              "HAVING."
            ],
            "solution": "GROUP BY client_id HAVING COUNT(*) > 2",
            "check": {
              "type": "keywords",
              "keywords": [
                "having"
              ],
              "success": "Correct : HAVING."
            }
          },
          "quiz": [
            {
              "question": "Où va une condition sur un agrégat ?",
              "options": [
                "HAVING",
                "WHERE",
                "ON",
                "LIMIT"
              ],
              "answer": 0,
              "explanation": "Le groupe est filtré.",
              "type": "single",
              "difficulty": 1,
              "hints": [],
              "id": "sqlj-01-q1"
            },
            {
              "question": "Où va une condition sur une ligne ?",
              "options": [
                "WHERE",
                "HAVING",
                "GROUP",
                "ORDER"
              ],
              "answer": 0,
              "explanation": "Avant le regroupement.",
              "type": "single",
              "difficulty": 1,
              "hints": [],
              "id": "sqlj-01-q2"
            }
          ],
          "summary": [
            "WHERE avant, HAVING après.",
            "Agrégats dans HAVING.",
            "Lisibilité."
          ],
          "nextStep": "Chapitre suivant : « Jointures »."
        },
        {
          "id": "sqlj-02",
          "title": "Jointures",
          "duration": 20,
          "objectives": [
            "Joindre deux tables",
            "Choisir INNER ou LEFT",
            "Éviter les produits cartésiens"
          ],
          "content": [
            {
              "type": "p",
              "text": "JOIN relie les tables par une condition ; LEFT JOIN conserve les lignes sans correspondance."
            },
            {
              "type": "code",
              "lang": "sql",
              "code": "SELECT c.nom, o.id\nFROM clients c\nJOIN commandes o ON o.client_id = c.id;",
              "title": "Jointure"
            }
          ],
          "exercise": {
            "title": "Joindre",
            "instructions": "Joignez clients et commandes par client_id.",
            "hints": [
              "JOIN ON."
            ],
            "solution": "SELECT * FROM clients JOIN commandes ON commandes.client_id = clients.id",
            "check": {
              "type": "keywords",
              "keywords": [
                "join",
                "on"
              ],
              "success": "Correct : JOIN ON."
            }
          },
          "quiz": [
            {
              "question": "Que fait LEFT JOIN ?",
              "options": [
                "Il garde les lignes de gauche",
                "Il supprime",
                "Il trie",
                "Il agrège"
              ],
              "answer": 0,
              "explanation": "Même sans correspondance.",
              "type": "single",
              "difficulty": 1,
              "hints": [],
              "id": "sqlj-02-q1"
            },
            {
              "question": "Que risque une jointure sans condition ?",
              "options": [
                "Un produit cartésien",
                "Une erreur",
                "Rien",
                "Un index"
              ],
              "answer": 0,
              "explanation": "Toutes les combinaisons sortent.",
              "type": "single",
              "difficulty": 1,
              "hints": [],
              "id": "sqlj-02-q2"
            }
          ],
          "summary": [
            "JOIN ON.",
            "LEFT pour conserver.",
            "Pas de produit cartésien."
          ],
          "nextStep": "Chapitre suivant : « Sous-requêtes »."
        },
        {
          "id": "sqlj-03",
          "title": "Sous-requêtes",
          "duration": 20,
          "objectives": [
            "Écrire une sous-requête",
            "Utiliser IN et EXISTS",
            "Comparer avec jointure"
          ],
          "content": [
            {
              "type": "p",
              "text": "Une sous-requête renvoie une valeur, une liste ou un booléen ; EXISTS teste la présence."
            },
            {
              "type": "code",
              "lang": "sql",
              "code": "SELECT nom FROM clients\nWHERE id IN (SELECT client_id FROM commandes WHERE montant > 100);",
              "title": "IN"
            }
          ],
          "exercise": {
            "title": "Filtrer",
            "instructions": "Sélectionnez les clients ayant une commande > 100.",
            "hints": [
              "IN ou EXISTS."
            ],
            "solution": "SELECT nom FROM clients WHERE id IN (SELECT client_id FROM commandes WHERE montant > 100)",
            "check": {
              "type": "keywords",
              "keywords": [
                "in (",
                "exists"
              ],
              "success": "Correct : sous-requête."
            }
