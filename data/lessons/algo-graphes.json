        {
          "id": "alg7-03",
          "title": "Parcours en largeur et en profondeur",
          "duration": 20,
          "objectives": [
            "Utiliser une file pour le BFS",
            "Utiliser une pile pour le DFS",
            "Choisir selon le besoin"
          ],
          "content": [
            {
              "type": "p",
              "text": "Le parcours en largeur (BFS) explore les voisins de proche en proche avec une file ; le parcours en profondeur (DFS) descend le plus loin possible avec une pile ou la récursion."
            },
            {
              "type": "code",
              "lang": "text",
              "code": "BFS(départ) : file ← [départ] ; visités ← {}\nTANT QUE file non vide FAIRE\n  s ← défiler(file)\n  POUR chaque voisin v de s FAIRE\n    SI v non visité ALORS visiter(v) ; enfiler(file, v)",
              "title": "Parcours en largeur"
            },
            {
              "type": "p",
              "text": "BFS trouve le plus court chemin en nombre d'arêtes dans un graphe non pondéré ; DFS sert aux cycles, aux composantes et aux tris topologiques."
            },
            {
              "type": "tip",
              "text": "Marquez un sommet comme visité au moment de l'enfiler, pas au moment de le défiler, pour éviter les doublons."
            }
          ],
          "exercise": {
            "title": "Choisir le parcours",
