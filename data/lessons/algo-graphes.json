        {
          "id": "alg7-05",
          "title": "Complexité temporelle",
          "duration": 20,
          "objectives": [
            "Distinguer meilleur, moyen et pire cas",
            "Analyser une boucle",
            "Relier complexité et choix"
          ],
          "content": [
            {
              "type": "p",
              "text": "La complexité temporelle compte les opérations en fonction de n. On distingue le meilleur cas, le cas moyen et le pire cas."
            },
            {
              "type": "code",
              "lang": "text",
              "code": "POUR i DE 0 À n - 1 FAIRE          // n itérations\n  POUR j DE 0 À n - 1 FAIRE        // n fois chacune\n    opération                      // O(n²)",
              "title": "Boucles imbriquées"
            },
            {
              "type": "p",
              "text": "Une boucle simple est O(n) ; deux boucles imbriquées sont O(n²) ; une division par deux à chaque étape donne O(log n)."
            },
            {
              "type": "tip",
              "text": "Le pire cas guide la robustesse ; le cas moyen guide les performances attendues."
            }
          ],
          "exercise": {
