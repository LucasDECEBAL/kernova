        {
          "id": "alg7-01",
          "title": "Arbres",
          "duration": 20,
          "objectives": [
            "Reconnaître un arbre",
            "Nommer racine, feuilles, hauteur",
            "Parcourir un arbre binaire"
          ],
          "content": [
            {
              "type": "p",
              "text": "Un arbre est un graphe connexe sans cycle : chaque nœud sauf la racine a un parent, et chaque nœud peut avoir des enfants."
            },
            {
              "type": "code",
              "lang": "text",
              "code": "        A\n      /   \\\n     B     C\n    / \\\n   D   E",
              "title": "Arbre binaire"
            },
            {
              "type": "p",
              "text": "La hauteur est le nombre de niveaux ; un arbre binaire limite chaque nœud à deux enfants. Les parcours préfixe, infixe et suffixe changent l'ordre de visite."
            },
            {
              "type": "tip",
              "text": "Un arbre binaire de recherche range les plus petits à gauche et les plus grands à droite : la recherche suit un chemin unique."
            }
          ],
          "exercise": {
            "title": "Identifier les feuilles",
            "instructions": "Dans l'arbre précédent, quels nœuds sont des feuilles ?",
            "hints": [
              "Une feuille n'a aucun enfant."
            ],
            "solution": "D, E et C.",
            "check": {
              "type": "keywords",
              "keywords": [
                "d",
                "e",
                "c"
              ],
              "success": "Correct : D, E et C."
            }
          },
          "quiz": [
            {
              "question": "Qu'est-ce qu'une feuille ?",
              "options": [
                "Un nœud sans enfant",
                "La racine",
                "Un cycle",
                "Une arête"
              ],
              "answer": 0,
              "explanation": "Elle termine une branche.",
              "type": "single",
              "difficulty": 1,
              "hints": [],
              "id": "alg7-01-q1"
            },
            {
              "question": "Qu'est-ce qu'un arbre binaire ?",
              "options": [
                "Un arbre où chaque nœud a au plus deux enfants",
                "Un arbre de deux nœuds",
                "Un graphe pondéré",
                "Une liste"
              ],
              "answer": 0,
              "explanation": "Deux enfants maximum.",
              "type": "single",
              "difficulty": 1,
              "hints": [],
              "id": "alg7-01-q2"
            }
          ],
          "summary": [
            "Arbre : connexe sans cycle.",
