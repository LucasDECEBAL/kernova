        {
          "id": "rct3-04",
          "title": "Architecture d'une application React",
          "duration": 20,
          "objectives": [
            "Séparer présentation et logique",
            "Organiser par fonctionnalité",
            "Limiter les dépendances"
          ],
          "content": [
            {
              "type": "p",
              "text": "Une application React se découpe par fonctionnalité : composants de présentation, hooks métier, accès aux données, routes."
            },
            {
              "type": "code",
              "lang": "text",
              "code": "src/\n├── features/taches/\n│   ├── TachesPage.jsx\n│   ├── useTaches.js\n│   └── api.js\n└── ui/",
              "title": "Organisation"
            },
            {
              "type": "tip",
              "text": "Un composant de présentation ne devrait pas connaître fetch : la logique vit dans un hook ou un service."
            }
          ],
          "exercise": {
            "title": "Organiser",
            "instructions": "Où placer l'appel réseau d'une fonctionnalité ?",
            "hints": [
              "Pas dans le composant de présentation."
            ],
            "solution": "Dans un module api ou un hook de la fonctionnalité.",
            "check": {
