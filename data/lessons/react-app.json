        {
          "id": "rct3-01",
          "title": "Chargement des données",
          "duration": 20,
          "objectives": [
            "Charger dans un effet",
            "Gérer chargement et erreur",
            "Éviter les mises à jour après démontage"
          ],
          "content": [
            {
              "type": "p",
              "text": "Le chargement de données combine état de chargement, données et erreur. Un drapeau annulé évite la mise à jour après démontage."
            },
            {
              "type": "code",
              "lang": "jsx",
              "code": "useEffect(() => {\n  let actif = true;\n  charger().then((d) => actif && setDonnees(d)).catch(setErreur);\n  return () => { actif = false; };\n}, []);",
              "title": "Chargement"
            },
            {
              "type": "warning",
              "text": "Sans protection, une réponse lente peut écraser un état plus récent ou un composant démonté."
            }
          ],
          "exercise": {
            "title": "Protéger",
            "instructions": "Que vérifier avant de mettre à jour l'état ?",
            "hints": [
              "Que le composant est toujours actif."
            ],
            "solution": "Un drapeau actif, remis à false dans le nettoyage.",
            "check": {
              "type": "keywords",
              "keywords": [
                "actif",
                "nettoyage"
              ],
              "success": "Correct : drapeau de nettoyage."
            }
          },
          "quiz": [
            {
              "question": "Quels états pour un chargement ?",
              "options": [
                "Chargement, données, erreur",
                "Un seul booléen",
                "Aucun",
                "Le CSS"
              ],
              "answer": 0,
              "explanation": "Chaque cas a un rendu.",
              "type": "single",
              "difficulty": 1,
              "hints": [],
              "id": "rct3-01-q1"
            },
            {
              "question": "Pourquoi éviter les mises à jour après démontage ?",
              "options": [
                "Pour éviter les fuites et avertissements",
                "Pour le CSS",
                "Pour le SEO",
                "Pour le réseau"
              ],
              "answer": 0,
              "explanation": "La mémoire est libérée.",
              "type": "single",
              "difficulty": 1,
              "hints": [],
              "id": "rct3-01-q2"
            }
          ],
          "summary": [
            "Chargement + erreur.",
            "Drapeau actif.",
            "Nettoyage dans l'effet."
          ]
        },
        {
          "id": "rct3-02",
          "title": "Gestion des erreurs",
          "duration": 20,
          "objectives": [
            "Afficher une erreur utile",
            "Proposer une nouvelle tentative",
            "Éviter les écrans blancs"
          ],
          "content": [
            {
              "type": "p",
              "text": "Une erreur de chargement doit être visible et actionnable : message clair, bouton réessayer, et conservation de l'état précédent si possible."
            },
            {
              "type": "code",
              "lang": "jsx",
              "code": "{erreur ? (\n  <div role=\"alert\">\n    <p>{erreur}</p>\n    <button onClick={recharger}>Réessayer</button>\n  </div>\n) : <Liste elements={donnees} />}",
              "title": "Erreur actionnable"
            },
            {
              "type": "tip",
              "text": "role=\"alert\" annonce l'erreur aux lecteurs d'écran dès son apparition."
            }
          ],
          "exercise": {
            "title": "Annoncer",
            "instructions": "Quel rôle ARIA pour une erreur affichée dynamiquement ?",
            "hints": [
              "Une alerte."
            ],
            "solution": "role=\"alert\"",
            "check": {
              "type": "keywords",
              "keywords": [
                "alert"
              ],
              "success": "Correct : role=\"alert\"."
            }
          },
          "quiz": [
            {
              "question": "Que doit proposer une erreur ?",
              "options": [
                "Une action",
                "Rien",
                "Une couleur",
                "Un log"
              ],
              "answer": 0,
              "explanation": "L'utilisateur peut réessayer.",
              "type": "single",
              "difficulty": 1,
              "hints": [],
              "id": "rct3-02-q1"
            },
            {
              "question": "Que faire des données précédentes ?",
              "options": [
                "Les conserver si possible",
                "Les supprimer",
                "Les dupliquer",
                "Les cacher"
              ],
              "answer": 0,
              "explanation": "L'écran reste utile.",
              "type": "single",
              "difficulty": 1,
              "hints": [],
              "id": "rct3-02-q2"
            }
          ],
          "summary": [
            "Erreur visible et actionnable.",
            "role=alert.",
            "Ne pas vider inutilement."
          ]
        },
        {
          "id": "rct3-03",
          "title": "Composants réutilisables",
          "duration": 20,
          "objectives": [
            "Définir une API de props",
            "Composer plutôt qu'hériter",
            "Documenter les variantes"
          ],
          "content": [
            {
              "type": "p",
              "text": "Un composant réutilisable a une API de props claire : children pour composer, variantes explicites, pas de dépendance à un contexte implicite."
            },
            {
              "type": "code",
              "lang": "jsx",
              "code": "function Carte({ titre, children, ton = \"neutre\" }) {\n  return (\n    <section className={\"carte carte--\" + ton}>\n      <h2>{titre}</h2>\n      {children}\n    </section>\n  );\n}",
              "title": "API de props"
            },
            {
              "type": "warning",
              "text": "Un composant qui devine son contexte devient difficile à réutiliser : rendez les dépendances explicites."
            }
          ],
          "exercise": {
            "title": "Composer",
            "instructions": "Quelle prop transmet le contenu imbriqué ?",
            "hints": [
              "Une prop spéciale."
            ],
            "solution": "children",
            "check": {
              "type": "keywords",
              "keywords": [
                "children"
              ],
              "success": "Correct : children."
            }
          },
          "quiz": [
