            },
            {
              "question": "Pourquoi documenter les variantes ?",
              "options": [
                "Pour un usage cohérent",
                "Pour le CSS",
                "Pour le réseau",
                "Pour le SEO"
              ],
              "answer": 0,
              "explanation": "Les états sont connus.",
              "type": "single",
              "difficulty": 1,
              "hints": [],
              "id": "rct3-03-q2"
            }
          ],
          "summary": [
            "Props explicites.",
            "children pour composer.",
            "Variantes documentées."
          ]
