            "Revalider côté serveur"
          ],
          "content": [
            {
              "type": "p",
              "text": "La validation côté client guide l'utilisateur ; elle se double toujours d'une validation serveur, car le client est contournable."
            },
            {
              "type": "code",
              "lang": "js",
              "code": "if (!email.includes(\"@\")) {\n  erreur.textContent = \"Adresse invalide\";\n  return;\n}\nform.reset();",
              "title": "Validation simple"
            },
            {
              "type": "warning",
              "text": "Une validation uniquement en JavaScript n'est pas une sécurité : un script peut être désactivé ou modifié."
            }
          ],
          "exercise": {
