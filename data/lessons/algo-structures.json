        {
          "id": "alg6-01",
          "title": "Tri rapide",
          "duration": 20,
          "objectives": [
            "Choisir un pivot",
            "Partitionner",
            "Comprendre le pire cas"
          ],
          "content": [
            {
              "type": "p",
              "text": "Le tri rapide choisit un pivot, place les plus petits avant et les plus grands après, puis trie chaque côté récursivement."
            },
            {
              "type": "code",
              "lang": "text",
              "code": "FONCTION triRapide(t, bas, haut)\n  SI bas < haut ALORS\n    p ← partition(t, bas, haut)\n    triRapide(t, bas, p - 1)\n    triRapide(t, p + 1, haut)\nFIN FONCTION",
              "title": "Structure du tri rapide"
            },
            {
              "type": "p",
              "text": "En moyenne O(n log n) ; si le pivot est toujours le plus petit ou le plus grand, la partition est déséquilibrée et le coût devient O(n²)."
            },
            {
              "type": "tip",
              "text": "Un pivot aléatoire ou médian réduit fortement le risque de pire cas sur des données déjà triées."
            }
          ],
          "exercise": {
            "title": "Pire cas",
            "instructions": "Quand le tri rapide atteint-il O(n²) ?",
            "hints": [
              "Pivot extrême à chaque étape."
            ],
            "solution": "Quand chaque partition est déséquilibrée, par exemple pivot toujours minimal sur un tableau trié.",
            "check": {
              "type": "keywords",
              "keywords": [
                "pivot",
                "deséquilibr",
                "desequilibr"
              ],
              "success": "Correct : pivot extrême, partitions déséquilibrées."
            }
          },
          "quiz": [
            {
              "question": "Que fait la partition ?",
              "options": [
                "Elle range autour du pivot",
                "Elle trie définitivement",
                "Elle fusionne",
                "Elle cherche un élément"
              ],
              "answer": 0,
              "explanation": "Plus petits d'un côté, plus grands de l'autre.",
              "type": "single",
              "difficulty": 1,
              "hints": [],
              "id": "alg6-01-q1"
            },
            {
              "question": "Quelle est sa complexité moyenne ?",
              "options": [
                "O(n log n)",
                "O(n)",
                "O(log n)",
                "O(n²)"
              ],
              "answer": 0,
              "explanation": "La moyenne est bonne, le pire cas mauvais.",
              "type": "single",
              "difficulty": 1,
              "hints": [],
              "id": "alg6-01-q2"
            }
          ],
          "summary": [
            "Pivot, partition, récursion.",
            "Moyenne O(n log n).",
            "Pire cas O(n²)."
          ],
          "nextStep": "Chapitre suivant : « Récursivité »."
        },
        {
          "id": "alg6-02",
          "title": "Récursivité",
          "duration": 20,
          "objectives": [
            "Écrire un cas de base",
            "Faire un appel plus petit",
            "Comprendre la pile d'appels"
          ],
          "content": [
            {
              "type": "p",
              "text": "Une fonction récursive s'appelle elle-même sur un problème plus petit, jusqu'à un cas de base qui arrête la descente."
            },
            {
              "type": "code",
              "lang": "text",
              "code": "FONCTION factorielle(n)\n  SI n ≤ 1 ALORS RETOURNER 1\n  RETOURNER n × factorielle(n - 1)\nFIN FONCTION",
              "title": "Factorielle"
            },
            {
              "type": "p",
              "text": "Chaque appel empile un contexte ; une récursion sans cas de base atteint la limite de pile et provoque un débordement."
            },
            {
              "type": "warning",
              "text": "La récursivité profonde consomme de la pile : pour de grands n, une version itérative est souvent plus sûre."
            }
          ],
          "exercise": {
            "title": "Trouver le cas de base",
            "instructions": "Quel est le cas de base de factorielle(n) ?",
            "hints": [
              "Le plus petit n acceptable."
            ],
            "solution": "n ≤ 1, qui renvoie 1.",
            "check": {
              "type": "keywords",
              "keywords": [
                "n ≤ 1",
                "n <= 1",
                "0",
                "1"
              ],
              "success": "Correct : n ≤ 1."
            }
          },
          "quiz": [
            {
              "question": "Qu'est-ce qu'un cas de base ?",
