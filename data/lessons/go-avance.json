              "answer": 0,
              "explanation": "L'implémentation est structurelle.",
              "type": "single",
              "difficulty": 1,
              "hints": [],
              "id": "go2-01-q1"
            },
            {
              "question": "Que vaut une interface vide ?",
              "options": [
                "Elle accepte tout type",
