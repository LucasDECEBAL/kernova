          "content": [
            {
              "type": "p",
              "text": "Une interface Go décrit des méthodes ; un type l'implémente implicitement en les définissant."
            },
            {
              "type": "list",
              "items": [
                "Aucun mot-clé implements.",
                "Une interface vide any accepte tout.",
                "Préférez les interfaces petites."
              ]
            }
          ],
          "exercise": {
            "title": "Implémenter",
            "instructions": "Quelle méthode suffit pour l'interface Forme { Aire() float64 } ?",
            "hints": [
              "La signature exacte.",
              "Le type doit définir Aire."
            ],
            "solution": "Définir func (t MonType) Aire() float64.",
            "check": {
              "type": "keywords",
              "keywords": [
                "aire()"
              ],
              "success": "Correct : méthode Aire."
            }
          },
          "quiz": [
            {
              "question": "Comment un type implémente-t-il une interface ?",
              "options": [
                "Implicitement, par ses méthodes",
