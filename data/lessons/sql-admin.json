          "title": "Procédures stockées",
          "duration": 20,
          "objectives": [
            "Créer une procédure",
            "Passer des paramètres",
            "Comprendre les limites"
          ],
          "content": [
            {
              "type": "p",
              "text": "Une procédure stockée regroupe du SQL exécuté côté serveur ; elle centralise une logique."
            },
            {
              "type": "code",
              "lang": "sql",
              "code": "CREATE PROCEDURE archiver_commandes()\nBEGIN\n  DELETE FROM commandes WHERE date < CURRENT_DATE - INTERVAL '1 year';\nEND;",
              "title": "Procédure"
            }
          ],
          "exercise": {
            "title": "Créer",
            "instructions": "Quelle instruction crée une procédure ?",
            "hints": [
              "Un CREATE dédié."
            ],
            "solution": "CREATE PROCEDURE",
            "check": {
              "type": "keywords",
              "keywords": [
                "create procedure"
              ],
              "success": "Correct : CREATE PROCEDURE."
            }
          },
          "quiz": [
            {
              "question": "Où s'exécute la procédure ?",
              "options": [
                "Côté serveur",
                "Dans le CSS",
