          "objectives": [
            "Créer un trigger",
            "Choisir le moment",
            "Éviter la logique cachée"
          ],
          "content": [
            {
              "type": "p",
              "text": "Un trigger s'exécute avant ou après une modification ; il doit rester simple et documenté."
            },
            {
              "type": "code",
              "lang": "sql",
              "code": "CREATE TRIGGER maj_date\nBEFORE UPDATE ON commandes\nFOR EACH ROW EXECUTE FUNCTION maj_modifie_le();",
              "title": "Trigger"
            }
          ],
          "exercise": {
            "title": "Choisir",
            "instructions": "Quand un trigger BEFORE s'exécute-t-il ?",
