        {
          "id": "sqlad-02",
          "title": "Fonctions SQL",
          "duration": 20,
          "objectives": [
            "Créer une fonction",
            "Retourner une valeur",
            "Différencier procédure"
          ],
          "content": [
            {
              "type": "p",
              "text": "Une fonction renvoie une valeur et s'utilise dans une requête ; une procédure exécute des actions."
            },
            {
              "type": "code",
              "lang": "sql",
              "code": "CREATE FUNCTION ttc(prix NUMERIC) RETURNS NUMERIC AS $$\n  SELECT prix * 1.2;\n$$ LANGUAGE sql;",
              "title": "Fonction"
            }
          ],
          "exercise": {
            "title": "Différencier",
            "instructions": "Que renvoie une fonction ?",
            "hints": [
              "Une valeur."
            ],
            "solution": "Une valeur utilisable dans une requête.",
            "check": {
              "type": "keywords",
              "keywords": [
                "valeur"
              ],
              "success": "Correct : une valeur."
            }
          },
          "quiz": [
            {
              "question": "Où utiliser une fonction ?",
              "options": [
                "Dans SELECT",
                "Dans le CSS",
                "Dans le DNS",
                "Dans un cookie"
