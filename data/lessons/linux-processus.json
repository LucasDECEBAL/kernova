          "duration": 20,
          "objectives": [
            "Lire les processus",
            "Envoyer un signal",
            "Arrêter proprement"
          ],
          "content": [
            {
              "type": "p",
              "text": "ps et top listent les processus ; kill envoie un signal. SIGTERM demande un arrêt propre, SIGKILL force."
            },
            {
              "type": "list",
              "items": [
                "SIGTERM d'abord.",
                "nice/renice pour la priorité.",
                "Un processus zombie attend son parent."
              ]
            }
          ],
          "exercise": {
            "title": "Arrêter",
            "instructions": "Quel signal demander pour un arrêt propre ?",
            "hints": [
              "Le signal par défaut.",
              "Il laisse le processus se terminer."
            ],
            "solution": "SIGTERM (kill PID)",
            "check": {
              "type": "keywords",
              "keywords": [
                "sigterm"
              ],
              "success": "Correct : SIGTERM."
            }
          },
          "quiz": [
            {
              "question": "Que fait SIGKILL ?",
              "options": [
                "Il force l'arrêt",
