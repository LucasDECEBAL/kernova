        },
        {
          "id": "lin3-02",
          "title": "Services et systemd",
          "duration": 20,
          "objectives": [
            "Gérer un service",
            "Activer au démarrage",
            "Lire un statut"
          ],
          "content": [
            {
              "type": "p",
              "text": "systemctl démarre, arrête et active les services ; daemon-reload relit les unités."
            },
            {
              "type": "list",
              "items": [
                "systemctl status/start/stop.",
                "enable --now.",
                "journalctl -u pour les logs."
              ]
            }
          ],
          "exercise": {
            "title": "Activer",
            "instructions": "Quelle commande active un service immédiatement et au démarrage ?",
            "hints": [
              "Une option combinée.",
              "enable et start."
            ],
            "solution": "systemctl enable --now mon-service",
            "check": {
              "type": "keywords",
              "keywords": [
                "enable",
                "now"
              ],
              "success": "Correct : enable --now."
            }
          },
          "quiz": [
            {
              "question": "Que fait daemon-reload ?",
              "options": [
                "Il relit les unités",
                "Il démarre",
