        {
          "id": "lin3-03",
          "title": "Journalisation",
          "duration": 20,
          "objectives": [
            "Lire le journal",
            "Filtrer par service",
            "Comprendre la rotation"
          ],
          "content": [
            {
              "type": "p",
              "text": "journalctl lit le journal systemd ; les journaux texte vivent dans /var/log et sont rotés par logrotate."
            },
            {
              "type": "list",
              "items": [
                "journalctl -u service.",
                "-f pour suivre.",
                "logrotate limite la taille."
              ]
            }
          ],
          "exercise": {
            "title": "Filtrer",
            "instructions": "Comment suivre les logs d'un service en direct ?",
            "hints": [
              "En combinaison avec -u.",
              "Une option de suivi."
            ],
            "solution": "journalctl -u mon-service -f",
            "check": {
              "type": "keywords",
              "keywords": [
                "journalctl",
                "-f"
              ],
              "success": "Correct : journalctl -f."
            }
          },
          "quiz": [
