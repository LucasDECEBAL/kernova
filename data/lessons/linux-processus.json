                "Il renice"
              ],
              "answer": 0,
              "explanation": "Aucun nettoyage possible.",
              "type": "single",
              "difficulty": 1,
              "hints": [],
              "id": "lin3-01-q1"
            },
            {
              "question": "Que fait renice ?",
              "options": [
                "Il change la priorité",
                "Il tue",
                "Il liste",
                "Il monte"
              ],
              "answer": 0,
              "explanation": "La priorité est ajustée.",
              "type": "single",
              "difficulty": 1,
              "hints": [],
              "id": "lin3-01-q2"
            }
          ],
          "summary": [
            "ps/top.",
            "SIGTERM puis SIGKILL.",
            "renice."
          ],
