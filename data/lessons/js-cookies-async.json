      "chapters": [
        {
          "id": "jsc-01",
          "title": "Comprendre les cookies",
          "duration": 20,
          "objectives": [
            "Lire un cookie",
            "Comprendre les attributs",
            "Éviter les données sensibles"
          ],
          "content": [
            {
              "type": "p",
              "text": "Un cookie est un petit texte envoyé au serveur à chaque requête. Il se règle par document.cookie et des attributs (Secure, HttpOnly, SameSite)."
            },
            {
              "type": "code",
              "lang": "js",
              "code": "document.cookie = \"theme=dark; Path=/; SameSite=Lax\";\ndocument.cookie.split(\"; \").find((c) => c.startsWith(\"theme=\"));",
              "title": "Cookie simple"
            },
            {
              "type": "warning",
              "text": "HttpOnly interdit la lecture en JavaScript : c'est justement ce qu'il faut pour un cookie de session."
            }
          ],
          "exercise": {
            "title": "Sécuriser",
            "instructions": "Quel attribut empêche JavaScript de lire un cookie ?",
            "hints": [
              "Un attribut côté serveur."
            ],
            "solution": "HttpOnly",
            "check": {
              "type": "keywords",
              "keywords": [
                "httponly"
              ],
              "success": "Correct : HttpOnly."
            }
          },
          "quiz": [
            {
              "question": "Quel attribut limite les requêtes cross-site ?",
              "options": [
                "SameSite",
                "Secure",
                "Path",
                "Domain"
              ],
              "answer": 0,
              "explanation": "SameSite contrôle l'envoi.",
              "type": "single",
              "difficulty": 1,
              "hints": [],
              "id": "jsc-01-q1"
            },
            {
              "question": "Que signifie Secure ?",
              "options": [
                "Envoi uniquement en HTTPS",
                "Cookie chiffré",
                "Cookie permanent",
                "Cookie local"
              ],
              "answer": 0,
              "explanation": "Le transport est protégé.",
              "type": "single",
              "difficulty": 1,
              "hints": [],
              "id": "jsc-01-q2"
            }
          ],
          "summary": [
            "Cookies envoyés au serveur.",
            "HttpOnly et Secure.",
            "Pas de secret en clair."
          ],
          "nextStep": "Chapitre suivant : « Gérer les erreurs d'interface »."
        },
        {
          "id": "jsc-02",
          "title": "Gérer les erreurs d'interface",
          "duration": 20,
          "objectives": [
            "Afficher un état d'erreur",
            "Proposer une action",
            "Éviter les écrans morts"
          ],
          "content": [
            {
              "type": "p",
              "text": "Une erreur d'interface doit expliquer ce qui s'est passé et proposer une action : réessayer, revenir ou contacter."
            },
            {
              "type": "code",
              "lang": "js",
              "code": "function afficherErreur(message, action) {\n  zone.textContent = message;\n  boutonReessayer.hidden = !action;\n}",
              "title": "État d'erreur"
            },
            {
              "type": "tip",
              "text": "Un message d'erreur utile contient l'action suivante : « Réessayer » vaut mieux que « Erreur 500 »."
            }
          ],
          "exercise": {
            "title": "Afficher",
            "instructions": "Que doit proposer un écran d'erreur ?",
            "hints": [
              "Une action possible."
            ],
            "solution": "Une action : réessayer, revenir ou contacter.",
            "check": {
              "type": "keywords",
              "keywords": [
                "reessayer",
                "action"
              ],
              "success": "Correct : une action."
            }
          },
          "quiz": [
            {
              "question": "Que doit contenir un bon message ?",
              "options": [
                "La cause et l'action",
                "Un code seul",
                "Rien",
                "Une couleur"
              ],
              "answer": 0,
              "explanation": "L'utilisateur doit pouvoir agir.",
              "type": "single",
              "difficulty": 1,
              "hints": [],
              "id": "jsc-02-q1"
            },
            {
              "question": "Que risque un écran vide ?",
              "options": [
                "L'utilisateur est bloqué",
                "Le CSS casse",
                "Le DNS tombe",
                "La RAM explose"
              ],
              "answer": 0,
              "explanation": "Sans issue, l'utilisateur abandonne.",
              "type": "single",
              "difficulty": 1,
              "hints": [],
              "id": "jsc-02-q2"
            }
          ],
          "summary": [
            "Expliquer et proposer.",
            "Réessayer visible.",
            "Pas d'écran mort."
          ],
          "nextStep": "Chapitre suivant : « Programmation asynchrone »."
        },
        {
          "id": "jsc-03",
          "title": "Programmation asynchrone",
          "duration": 20,
          "objectives": [
            "Comprendre l'asynchrone",
            "Éviter le blocage",
            "Ordonner les opérations"
          ],
          "content": [
            {
              "type": "p",
              "text": "Une opération asynchrone (réseau, minuteur, fichier) rend la main immédiatement : le résultat arrive plus tard via un callback, une promesse ou await."
            },
            {
              "type": "code",
              "lang": "js",
              "code": "console.log(\"1\");\nsetTimeout(() => console.log(\"2\"), 0);\nconsole.log(\"3\");\n// 1, 3, 2",
              "title": "Ordre d'exécution"
            },
            {
              "type": "warning",
              "text": "Une boucle lourde bloque l'interface même si le réseau est asynchrone : découpez ou déplacez le calcul dans un Worker."
            }
          ],
          "exercise": {
            "title": "Prédire",
            "instructions": "Quel ordre affiche 1, un setTimeout(0), puis 3 ?",
            "hints": [
              "Le synchrone passe avant."
            ],
            "solution": "1, 3, puis 2.",
            "check": {
              "type": "any",
              "any": [
                "1, 3, 2",
                "1 3 2"
              ],
              "success": "Correct : 1, 3, 2."
            }
          },
          "quiz": [
            {
              "question": "Que fait setTimeout ?",
              "options": [
                "Il planifie une exécution",
                "Il bloque",
                "Il recharge",
                "Il chiffre"
              ],
              "answer": 0,
              "explanation": "La fonction part plus tard.",
              "type": "single",
              "difficulty": 1,
              "hints": [],
              "id": "jsc-03-q1"
            },
            {
              "question": "Pourquoi l'interface reste-t-elle réactive ?",
              "options": [
                "Le travail async rend la main",
                "Le CPU s'arrête",
                "Le CSS bloque",
                "Le DNS attend"
              ],
              "answer": 0,
              "explanation": "La boucle d'événements continue.",
              "type": "single",
              "difficulty": 1,
              "hints": [],
              "id": "jsc-03-q2"
            }
          ],
          "summary": [
            "Async = résultat plus tard.",
            "Synchrone d'abord.",
            "Ne pas bloquer l'interface."
          ],
          "nextStep": "Chapitre suivant : « Callbacks »."
        },
        {
          "id": "jsc-04",
          "title": "Callbacks",
          "duration": 20,
          "objectives": [
            "Passer une fonction en argument",
            "Gérer l'erreur",
            "Éviter l'enfer des callbacks"
          ],
          "content": [
            {
              "type": "p",
              "text": "Un callback est une fonction passée à une autre, appelée plus tard. La convention Node place l'erreur en premier argument."
            },
            {
              "type": "code",
              "lang": "js",
              "code": "function charger(url, callback) {\n  fetch(url)\n    .then((r) => r.json())\n    .then((data) => callback(null, data))\n    .catch((err) => callback(err));\n}",
              "title": "Callback"
            },
            {
              "type": "warning",
              "text": "Des callbacks imbriqués sur plusieurs niveaux deviennent illisibles : utilisez les promesses ou async/await."
            }
          ],
          "exercise": {
            "title": "Convention",
            "instructions": "Quel argument reçoit un callback Node en cas d'erreur ?",
            "hints": [
              "Le premier."
            ],
            "solution": "L'erreur en premier argument (err, data).",
            "check": {
              "type": "keywords",
              "keywords": [
                "erreur",
                "premier"
              ],
              "success": "Correct : erreur en premier."
            }
          },
          "quiz": [
            {
              "question": "Qu'est-ce qu'un callback ?",
              "options": [
                "Une fonction appelée plus tard",
                "Un type de boucle",
                "Un cookie",
                "Un module"
              ],
              "answer": 0,
              "explanation": "Elle est passée en argument.",
              "type": "single",
              "difficulty": 1,
              "hints": [],
              "id": "jsc-04-q1"
            },
            {
              "question": "Pourquoi éviter les callbacks imbriqués ?",
              "options": [
                "La lisibilité se dégrade",
                "Le réseau ralentit",
                "Le CSS casse",
                "La RAM diminue"
              ],
              "answer": 0,
              "explanation": "La pyramide devient difficile à suivre.",
              "type": "single",
              "difficulty": 1,
              "hints": [],
              "id": "jsc-04-q2"
            }
          ],
          "summary": [
            "Callback = fonction différée.",
            "Erreur en premier.",
            "Promesses pour la lisibilité."
          ],
          "nextStep": "Chapitre suivant : « Promesses »."
        },
        {
          "id": "jsc-05",
          "title": "Promesses",
          "duration": 20,
          "objectives": [
            "Créer une promesse",
            "Chaîner then et catch",
            "Gérer plusieurs promesses"
          ],
          "content": [
            {
              "type": "p",
              "text": "Une promesse représente une valeur future : pending, fulfilled ou rejected. then traite le succès, catch l'erreur, finally nettoie."
            },
            {
              "type": "code",
              "lang": "js",
              "code": "fetch(\"/api/taches\")\n  .then((r) => r.json())\n  .then((taches) => afficher(taches))\n  .catch((err) => afficherErreur(err))\n  .finally(() => (chargement = false));",
              "title": "Chaîne de promesses"
            },
            {
              "type": "warning",
              "text": "Oublier return dans un then coupe la chaîne : le then suivant reçoit undefined."
            }
          ],
          "exercise": {
            "title": "Chaîner",
            "instructions": "Quelle méthode gère une promesse rejetée ?",
            "hints": [
              "Elle capture l'erreur."
            ],
            "solution": ".catch()",
            "check": {
              "type": "keywords",
              "keywords": [
                "catch"
              ],
              "success": "Correct : catch."
            }
          },
          "quiz": [
            {
              "question": "Quels états pour une promesse ?",
              "options": [
                "pending, fulfilled, rejected",
                "open, closed",
                "true, false",
                "sync, async"
              ],
              "answer": 0,
              "explanation": "Trois états possibles.",
              "type": "single",
              "difficulty": 1,
              "hints": [],
              "id": "jsc-05-q1"
            },
            {
              "question": "Que fait finally ?",
              "options": [
                "Il s'exécute dans tous les cas",
                "Seulement en succès",
                "Seulement en erreur",
                "Jamais"
              ],
              "answer": 0,
              "explanation": "Il nettoie l'état.",
              "type": "single",
              "difficulty": 1,
              "hints": [],
              "id": "jsc-05-q2"
            }
          ],
          "summary": [
            "Promesse = valeur future.",
            "then/catch/finally.",
            "Toujours retourner la promesse."
          ],
          "nextStep": "Le parcours est terminé : passez l'évaluation finale pour valider vos acquis."
        }
      ]
    }
  ]
}
