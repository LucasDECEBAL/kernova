          "content": [
            {
              "type": "p",
              "text": "Un projet TypeScript sépare le code source, les types partagés et la configuration. Le build produit le JavaScript exécutable."
            },
            {
              "type": "code",
              "lang": "text",
              "code": "src/\n├── types/\n├── domain/\n├── ui/\n└── main.ts\ntsconfig.json",
              "title": "Arborescence"
            },
            {
              "type": "tip",
              "text": "Les types partagés vont dans un dossier dédié : ils ne doivent pas dépendre de l'interface."
            }
          ],
          "exercise": {
            "title": "Organiser",
            "instructions": "Où placer les types partagés ?",
            "hints": [
