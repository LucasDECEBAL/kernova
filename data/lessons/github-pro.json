        {
          "id": "git6-04",
          "title": "Configurer un environnement de développement",
          "duration": 20,
          "objectives": [
            "Fixer les versions",
            "Partager la configuration",
            "Reproduire l'environnement"
          ],
          "content": [
            {
              "type": "p",
              "text": "Un environnement reproductible fixe les versions du langage, des outils et des dépendances. Il évite le « ça marche chez moi »."
            },
            {
              "type": "list",
              "items": [
                "Indiquer la version du langage (.nvmrc, .python-version).",
                "Verrouiller les dépendances.",
                "Documenter les variables d'environnement attendues.",
                "Automatiser l'installation dans un conteneur ou un devcontainer."
              ]
            },
            {
              "type": "warning",
              "text": "Un fichier .env.example documente les variables attendues, mais ne doit jamais contenir de vraie clé."
            }
          ],
          "exercise": {
            "title": "Reproduire",
            "instructions": "Quel fichier indique la version de Node attendue ?",
            "hints": [
              "Un fichier dédié à la version."
            ],
            "solution": ".nvmrc (ou le champ engines de package.json).",
            "check": {
              "type": "keywords",
              "keywords": [
                "nvmrc",
                "engines"
              ],
              "success": "Correct : .nvmrc ou engines."
            }
          },
          "quiz": [
