      "title": "GitHub : licences et contribution",
      "chapters": [
        {
          "id": "git6-01",
          "title": "Comprendre les licences logicielles",
          "duration": 20,
          "objectives": [
            "Distinguer MIT, Apache et GPL",
            "Choisir une licence",
            "Respecter les obligations"
          ],
          "content": [
            {
              "type": "p",
              "text": "Une licence définit ce que les autres peuvent faire avec le code. MIT est permissive, Apache ajoute une clause de brevets, GPL impose de partager les dérivés."
            },
            {
              "type": "table",
              "headers": [
                "Licence",
                "Usage",
                "Obligation"
              ],
              "rows": [
                [
                  "MIT",
                  "très permissive",
                  "conserver la notice"
                ],
                [
                  "Apache 2.0",
                  "permissive",
                  "notice et brevets"
                ],
                [
                  "GPL",
                  "copyleft",
                  "partager le dérivé sous GPL"
                ]
              ]
            },
            {
              "type": "warning",
              "text": "Sans licence, le code reste sous droit d'auteur : personne ne peut légalement le réutiliser, même s'il est public."
            }
          ],
          "exercise": {
            "title": "Choisir une licence",
            "instructions": "Vous voulez que tout le monde puisse réutiliser votre bibliothèque, y compris dans un produit fermé. Quelle famille ?",
            "hints": [
              "Il faut une licence permissive."
            ],
            "solution": "Une licence permissive, par exemple MIT ou Apache 2.0.",
            "check": {
              "type": "any",
              "any": [
                "permissive",
                "mit",
                "apache"
              ],
              "success": "Correct : une licence permissive."
            }
          },
          "quiz": [
            {
              "question": "Que permet MIT ?",
              "options": [
                "Réutilisation large avec notice",
                "Interdiction commerciale",
                "Obligation de GPL",
                "Aucune utilisation"
              ],
              "answer": 0,
              "explanation": "MIT est permissive.",
              "type": "single",
              "difficulty": 1,
              "hints": [],
              "id": "git6-01-q1"
            },
            {
              "question": "Que fait le copyleft ?",
              "options": [
                "Il impose de partager les dérivés",
                "Il interdit la modification",
                "Il supprime la notice",
                "Il rend le code secret"
              ],
              "answer": 0,
              "explanation": "La GPL en est l'exemple.",
              "type": "single",
              "difficulty": 1,
              "hints": [],
              "id": "git6-01-q2"
            }
          ],
          "summary": [
            "La licence définit les droits.",
            "Permissive ou copyleft.",
            "Sans licence, pas de réutilisation légale."
          ],
          "nextStep": "Chapitre suivant : « Contribuer à un projet open source »."
        },
        {
          "id": "git6-02",
          "title": "Contribuer à un projet open source",
          "duration": 20,
          "objectives": [
            "Lire les règles de contribution",
            "Préparer un fork et une branche",
            "Proposer une PR utile"
          ],
          "content": [
            {
              "type": "p",
              "text": "Contribuer commence par lire CONTRIBUTING, le code de conduite et les issues ouvertes. Ensuite : fork, branche, tests, PR ciblée."
            },
            {
              "type": "list",
              "items": [
                "Choisir une issue adaptée à votre niveau.",
                "Respecter le style et les tests du projet.",
                "Une PR = un changement.",
                "Répondre aux retours avec des commits clairs."
              ]
            },
            {
              "type": "tip",
              "text": "Une petite correction de documentation bien faite ouvre souvent la porte à des contributions plus importantes."
            }
          ],
          "exercise": {
            "title": "Première étape",
            "instructions": "Que lire avant de proposer une contribution ?",
            "hints": [
