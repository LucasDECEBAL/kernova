            {
              "type": "code",
              "lang": "cpp",
              "code": "for (auto it = notes.begin(); it != notes.end(); ++it) {\n  std::cout << *it;\n}\nstd::sort(notes.begin(), notes.end());",
              "title": "Itérateurs"
            },
            {
              "type": "tip",
              "text": "Range-for est plus lisible ; gardez les itérateurs quand vous devez connaître la position."
            }
          ],
