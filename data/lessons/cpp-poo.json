        {
          "id": "cppp-01",
          "title": "Héritage",
          "duration": 20,
          "objectives": [
            "Dériver une classe",
            "Appeler le constructeur parent",
            "Comprendre public/protégé"
          ],
          "content": [
            {
              "type": "p",
              "text": "Une classe dérivée hérite des membres accessibles. Le constructeur parent s'appelle dans la liste d'initialisation."
            },
            {
              "type": "code",
              "lang": "cpp",
              "code": "class Animal {\npublic:\n  virtual void parler() const { }\n};\n\nclass Chien : public Animal {\npublic:\n  void parler() const override { std::cout << \"Wouf\"; }\n};",
              "title": "Héritage"
            },
            {
              "type": "warning",
              "text": "L'héritage public exprime « est un » ; pour « possède un », préférez la composition."
            }
          ],
          "exercise": {
            "title": "Initialiser",
            "instructions": "Comment appeler le constructeur de la classe de base ?",
            "hints": [
              "Liste d'initialisation."
            ],
            "solution": "Dans la liste d'initialisation : Base(args).",
            "check": {
              "type": "keywords",
              "keywords": [
                "base(",
                ":"
              ],
              "success": "Correct : initialisation de Base."
            }
          },
          "quiz": [
            {
              "question": "Que fait override ?",
              "options": [
                "Il vérifie la redéfinition",
                "Il hérite",
                "Il copie",
                "Il libère"
              ],
              "answer": 0,
              "explanation": "Le compilateur signale une erreur si la signature diffère.",
              "type": "single",
              "difficulty": 1,
              "hints": [],
              "id": "cppp-01-q1"
            },
            {
              "question": "Que signifie héritage public ?",
              "options": [
                "Relation « est un »",
                "Relation « possède »",
                "Une copie",
                "Une allocation"
              ],
              "answer": 0,
              "explanation": "Le type dérivé est un type de base.",
              "type": "single",
              "difficulty": 1,
              "hints": [],
              "id": "cppp-01-q2"
            }
          ],
          "summary": [
            "Héritage public = est un.",
            "override.",
            "Composition sinon."
          ],
          "nextStep": "Chapitre suivant : « Polymorphisme »."
        },
        {
          "id": "cppp-02",
          "title": "Polymorphisme",
          "duration": 20,
          "objectives": [
            "Utiliser virtual",
            "Appeler via une référence",
            "Éviter le slicing"
          ],
          "content": [
            {
              "type": "p",
              "text": "Une méthode virtual est choisie à l'exécution selon le type réel. Un pointeur ou une référence de base suffit."
            },
            {
              "type": "code",
              "lang": "cpp",
              "code": "void faireParler(const Animal& a) {\n  a.parler();\n}\nChien c;\nfaireParler(c);",
              "title": "Polymorphisme"
            },
            {
              "type": "warning",
              "text": "Passer un objet dérivé par valeur à un paramètre de base provoque le slicing : utilisez une référence."
            }
          ],
          "exercise": {
            "title": "Éviter",
            "instructions": "Comment passer un objet pour conserver le polymorphisme ?",
            "hints": [
              "Pas par valeur."
            ],
            "solution": "Par référence (const Base&) ou pointeur.",
            "check": {
              "type": "keywords",
              "keywords": [
                "reference",
                "référence",
                "pointeur"
              ],
              "success": "Correct : référence ou pointeur."
            }
          },
          "quiz": [
            {
              "question": "Quand la méthode virtuelle est-elle choisie ?",
              "options": [
                "À l'exécution",
