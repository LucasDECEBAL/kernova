              "answer": 0,
              "explanation": "Le type réel décide.",
              "type": "single",
              "difficulty": 1,
              "hints": [],
              "id": "cppp-02-q1"
            },
            {
              "question": "Qu'est-ce que le slicing ?",
              "options": [
                "La perte de la partie dérivée",
                "Une copie profonde",
                "Une allocation",
                "Un template"
              ],
              "answer": 0,
              "explanation": "Le passage par valeur coupe l'objet.",
              "type": "single",
              "difficulty": 1,
              "hints": [],
              "id": "cppp-02-q2"
