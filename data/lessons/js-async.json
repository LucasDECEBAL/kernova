        {
          "id": "jsa2-04",
          "title": "Gestion des requêtes HTTP",
          "duration": 20,
          "objectives": [
            "Choisir la méthode",
            "Envoyer un corps JSON",
            "Annuler une requête"
          ],
          "content": [
            {
              "type": "p",
              "text": "GET lit, POST crée, PATCH modifie partiellement, DELETE supprime. Un corps JSON exige l'en-tête Content-Type et une sérialisation."
            },
            {
              "type": "code",
              "lang": "js",
              "code": "await fetch(\"/api/taches\", {\n  method: \"POST\",\n  headers: { \"Content-Type\": \"application/json\" },\n  body: JSON.stringify({ titre: \"Nouvelle tâche\" })\n});",
              "title": "Requête POST"
            },
            {
              "type": "warning",
              "text": "Ne mettez pas de données sensibles dans l'URL (GET) : elles apparaissent dans les journaux et l'historique."
            }
          ],
          "exercise": {
            "title": "Choisir",
            "instructions": "Quelle méthode pour créer une ressource ?",
            "hints": [
              "Création."
            ],
            "solution": "POST",
            "check": {
              "type": "keywords",
              "keywords": [
                "post"
              ],
              "success": "Correct : POST."
            }
          },
          "quiz": [
            {
