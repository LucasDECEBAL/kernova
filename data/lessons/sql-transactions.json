              "answer": 0,
              "explanation": "Le compromis est explicite.",
              "type": "single",
              "difficulty": 1,
              "hints": [],
              "id": "sqlt-03-q2"
            }
          ],
          "summary": [
            "Niveaux d'isolation.",
            "Anomalies.",
            "Compromis."
          ],
          "nextStep": "Chapitre suivant : « Verrouillage »."
        },
        {
          "id": "sqlt-04",
          "title": "Verrouillage",
          "duration": 20,
          "objectives": [
            "Comprendre les verrous",
            "Éviter les interblocages",
            "Ordonner les accès"
          ],
          "content": [
            {
              "type": "p",
              "text": "Un verrou protège une ressource pendant une transaction ; deux ordres opposés provoquent un interblocage."
            },
            {
              "type": "code",
              "lang": "sql",
              "code": "SELECT * FROM comptes WHERE id = 1 FOR UPDATE;",
              "title": "Verrou"
            }
          ],
          "exercise": {
            "title": "Éviter",
            "instructions": "Comment éviter un interblocage ?",
            "hints": [
              "Le même ordre d'accès."
            ],
            "solution": "Accéder toujours aux ressources dans le même ordre et prévoir un réessai.",
            "check": {
              "type": "keywords",
              "keywords": [
                "ordre"
              ],
              "success": "Correct : ordre constant."
            }
          },
          "quiz": [
            {
              "question": "Que fait FOR UPDATE ?",
