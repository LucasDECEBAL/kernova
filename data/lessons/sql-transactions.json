      "title": "Transactions et concurrence",
      "chapters": [
        {
          "id": "sqlt-01",
          "title": "Transactions",
          "duration": 20,
          "objectives": [
            "Regrouper des opérations",
            "Valider ou annuler",
            "Protéger les invariants"
          ],
          "content": [
            {
              "type": "p",
              "text": "BEGIN ouvre une transaction ; COMMIT valide, ROLLBACK annule. Les opérations forment un tout."
            },
            {
              "type": "code",
              "lang": "sql",
              "code": "BEGIN;\nUPDATE comptes SET solde = solde - 100 WHERE id = 1;\nUPDATE comptes SET solde = solde + 100 WHERE id = 2;\nCOMMIT;",
              "title": "Virement"
            }
          ],
          "exercise": {
            "title": "Annuler",
            "instructions": "Quelle commande annule une transaction ?",
            "hints": [
              "Un retour en arrière."
            ],
            "solution": "ROLLBACK",
            "check": {
              "type": "keywords",
              "keywords": [
                "rollback"
              ],
              "success": "Correct : ROLLBACK."
            }
          },
          "quiz": [
            {
              "question": "Que fait COMMIT ?",
              "options": [
                "Il valide",
                "Il annule",
                "Il trie",
                "Il joint"
              ],
              "answer": 0,
              "explanation": "Les changements sont écrits.",
              "type": "single",
              "difficulty": 1,
              "hints": [],
              "id": "sqlt-01-q1"
            },
            {
              "question": "Pourquoi une transaction pour un virement ?",
              "options": [
                "Éviter une perte d'argent",
                "Accélérer",
                "Chiffrer",
                "Trier"
              ],
              "answer": 0,
              "explanation": "Débit et crédit sont atomiques.",
              "type": "single",
              "difficulty": 1,
              "hints": [],
              "id": "sqlt-01-q2"
            }
          ],
          "summary": [
            "BEGIN/COMMIT/ROLLBACK.",
            "Atomicité.",
            "Invariants protégés."
          ],
          "nextStep": "Chapitre suivant : « Propriétés ACID »."
        },
        {
          "id": "sqlt-02",
          "title": "Propriétés ACID",
          "duration": 20,
          "objectives": [
            "Définir ACID",
            "Relier aux garanties",
            "Choisir le niveau"
          ],
          "content": [
            {
              "type": "p",
              "text": "ACID : atomicité, cohérence, isolation, durabilité. Ces garanties distinguent une base transactionnelle."
            },
            {
              "type": "code",
              "lang": "text",
              "code": "Atomicité : tout ou rien\nCohérence : contraintes respectées\nIsolation : transactions concurrentes\nDurabilité : écriture persistante",
              "title": "ACID"
            }
          ],
          "exercise": {
            "title": "Définir",
            "instructions": "Que signifie le A d'ACID ?",
            "hints": [
              "Tout ou rien."
            ],
            "solution": "Atomicité",
            "check": {
              "type": "keywords",
              "keywords": [
                "atomicite",
                "atomicité"
              ],
              "success": "Correct : atomicité."
            }
          },
          "quiz": [
            {
              "question": "Que garantit la durabilité ?",
              "options": [
                "Les données survivent à une panne",
                "Le tri",
                "Le CSS",
                "Le réseau"
              ],
              "answer": 0,
              "explanation": "L'écriture est persistante.",
              "type": "single",
              "difficulty": 1,
              "hints": [],
              "id": "sqlt-02-q1"
            },
            {
              "question": "Que garantit l'isolation ?",
              "options": [
                "Les transactions ne se perturbent pas",
                "La vitesse",
                "Le chiffrement",
                "Le tri"
              ],
              "answer": 0,
              "explanation": "Les effets concurrents sont contrôlés.",
              "type": "single",
              "difficulty": 1,
              "hints": [],
              "id": "sqlt-02-q2"
            }
          ],
          "summary": [
            "ACID.",
            "Atomicité.",
            "Durabilité."
          ],
          "nextStep": "Chapitre suivant : « Isolation »."
        },
        {
          "id": "sqlt-03",
          "title": "Isolation",
          "duration": 20,
          "objectives": [
            "Comprendre les niveaux",
            "Éviter les lectures sales",
            "Choisir le compromis"
          ],
          "content": [
            {
              "type": "p",
              "text": "Les niveaux d'isolation contrôlent les phénomènes de concurrence : lecture sale, non répétable, fantôme."
            },
            {
              "type": "code",
              "lang": "sql",
              "code": "SET TRANSACTION ISOLATION LEVEL READ COMMITTED;",
              "title": "Niveau"
            }
          ],
          "exercise": {
            "title": "Choisir",
            "instructions": "Quel phénomène évite READ COMMITTED ?",
            "hints": [
              "La lecture sale."
            ],
            "solution": "READ COMMITTED empêche les lectures sales.",
            "check": {
              "type": "keywords",
              "keywords": [
                "lecture sale"
              ],
              "success": "Correct : lecture sale."
            }
          },
          "quiz": [
