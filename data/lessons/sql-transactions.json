              "answer": 0,
              "explanation": "Les autres transactions attendent.",
              "type": "single",
              "difficulty": 1,
              "hints": [],
              "id": "sqlt-04-q1"
            },
            {
              "question": "Que fait un interblocage ?",
              "options": [
