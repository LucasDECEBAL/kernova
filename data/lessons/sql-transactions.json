        {
          "id": "sqlt-05",
          "title": "Points de sauvegarde",
          "duration": 20,
          "objectives": [
            "Créer un savepoint",
            "Revenir en arrière",
            "Utiliser en transaction longue"
          ],
          "content": [
            {
              "type": "p",
              "text": "SAVEPOINT marque un état intermédiaire ; ROLLBACK TO annule une partie sans perdre le début."
            },
            {
              "type": "code",
              "lang": "sql",
              "code": "BEGIN;\nINSERT INTO journal VALUES ('debut');\nSAVEPOINT apres_journal;\n-- erreur\nROLLBACK TO apres_journal;\nCOMMIT;",
              "title": "Savepoint"
            }
          ],
          "exercise": {
            "title": "Revenir",
            "instructions": "Comment revenir à un point intermédiaire ?",
            "hints": [
              "ROLLBACK TO."
            ],
            "solution": "ROLLBACK TO nom_du_savepoint",
            "check": {
              "type": "keywords",
              "keywords": [
                "rollback to"
              ],
              "success": "Correct : ROLLBACK TO."
            }
          },
