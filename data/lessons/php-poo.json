        {
          "id": "phpo-04",
          "title": "Gestion des erreurs",
          "duration": 20,
          "objectives": [
            "Attraper PDOException",
            "Journaliser",
            "Afficher un message sûr"
          ],
          "content": [
            {
              "type": "p",
              "text": "Les erreurs de base doivent être journalisées côté serveur et présenter un message générique à l'utilisateur."
            },
            {
              "type": "code",
              "lang": "php",
              "code": "try {\n    $pdo->beginTransaction();\n    // ...\n    $pdo->commit();\n} catch (PDOException $e) {\n    $pdo->rollBack();\n    error_log($e->getMessage());\n}",
              "title": "Transaction"
            },
            {
              "type": "p",
              "text": "Une transaction garantit que plusieurs écritures réussissent ou échouent ensemble."
            }
          ],
          "exercise": {
            "title": "Annuler",
            "instructions": "Que faire en cas d'échec dans une transaction ?",
            "hints": [
              "Annuler les écritures."
