            {
              "type": "code",
              "lang": "php",
              "code": "$stmt = $pdo->prepare(\"SELECT * FROM clients WHERE email = :email\");\n$stmt->execute([\"email\" => $email]);\n$client = $stmt->fetch(PDO::FETCH_ASSOC);",
              "title": "Requête préparée"
            },
            {
              "type": "p",
              "text": "Ne concaténez jamais une valeur dans le SQL, même avec addslashes()."
