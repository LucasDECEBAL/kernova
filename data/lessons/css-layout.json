      "title": "Dimensions et affichage",
      "chapters": [
        {
          "id": "cssl-01",
          "title": "Marges et espacements",
          "duration": 20,
          "objectives": [
            "Distinguer margin et padding",
            "Utiliser gap",
            "Gérer l'effondrement des marges"
          ],
          "content": [
            {
              "type": "p",
              "text": "margin espace l'élément de ses voisins ; padding espace le contenu de sa bordure. Les marges verticales de blocs adjacents peuvent fusionner."
            },
            {
              "type": "code",
              "lang": "css",
              "code": ".carte {\n  margin: 16px 0;\n  padding: 24px;\n  border: 1px solid #c3cbd3;\n}",
              "title": "Marge et rembourrage"
            },
            {
              "type": "tip",
              "text": "Dans Flexbox et Grid, utilisez gap plutôt que des marges entre enfants : l'espacement reste régulier."
            }
          ],
          "exercise": {
            "title": "Choisir la propriété",
            "instructions": "Vous voulez de l'espace à l'intérieur d'un cadre, autour du texte. margin ou padding ?",
            "hints": [
              "L'espace est dedans."
            ],
            "solution": "padding",
            "check": {
              "type": "keywords",
              "keywords": [
                "padding"
              ],
              "success": "Correct : padding."
            }
          },
          "quiz": [
            {
              "question": "Que fait margin ?",
              "options": [
                "Elle espace l'élément de ses voisins",
                "Elle espace le contenu",
                "Elle change la couleur",
                "Elle ajoute une bordure"
              ],
              "answer": 0,
              "explanation": "La marge est extérieure.",
              "type": "single",
              "difficulty": 1,
              "hints": [],
              "id": "cssl-01-q1"
            },
            {
              "question": "Que fait gap ?",
              "options": [
                "Il espace les enfants d'un conteneur flex/grid",
                "Il ajoute une bordure",
                "Il centre le texte",
                "Il change la police"
              ],
              "answer": 0,
              "explanation": "Gap évite les marges manuelles.",
              "type": "single",
              "difficulty": 1,
              "hints": [],
              "id": "cssl-01-q2"
            }
          ],
          "summary": [
            "margin dehors, padding dedans.",
            "gap pour les conteneurs.",
            "Attention aux marges qui fusionnent."
          ],
          "nextStep": "Chapitre suivant : « Bordures »."
        },
        {
          "id": "cssl-02",
          "title": "Bordures",
          "duration": 20,
          "objectives": [
            "Écrire une bordure",
            "Arrondir les angles",
            "Utiliser les styles de bordure"
          ],
          "content": [
            {
              "type": "p",
              "text": "border combine épaisseur, style et couleur. border-radius arrondit les angles ; outline sert au focus et ne prend pas de place."
            },
            {
              "type": "code",
              "lang": "css",
              "code": ".bouton {\n  border: 1px solid #17202b;\n  border-radius: 2px;\n}\n.bouton:focus-visible { outline: 3px solid #1e4fd0; }",
              "title": "Bordure et focus"
            },
            {
              "type": "warning",
              "text": "Supprimer outline sans le remplacer rend la navigation clavier invisible : gardez toujours un focus visible."
            }
          ],
          "exercise": {
            "title": "Arrondir",
            "instructions": "Quelle propriété arrondit les angles ?",
            "hints": [
              "Un rayon."
            ],
            "solution": "border-radius",
            "check": {
              "type": "keywords",
              "keywords": [
                "border-radius"
              ],
              "success": "Correct : border-radius."
            }
          },
          "quiz": [
            {
              "question": "Que fait outline ?",
              "options": [
                "Il dessine un contour de focus",
                "Il espace le contenu",
                "Il arrondit",
                "Il change la police"
              ],
              "answer": 0,
              "explanation": "Il ne modifie pas la mise en page.",
              "type": "single",
              "difficulty": 1,
              "hints": [],
              "id": "cssl-02-q1"
            },
            {
              "question": "Que combine border ?",
              "options": [
                "Épaisseur, style et couleur",
                "Marge et padding",
                "Police et taille",
                "Grille et flex"
              ],
              "answer": 0,
              "explanation": "C'est une propriété raccourcie.",
              "type": "single",
              "difficulty": 1,
              "hints": [],
              "id": "cssl-02-q2"
            }
          ],
          "summary": [
            "border = épaisseur + style + couleur.",
            "border-radius arrondit.",
            "Ne jamais supprimer le focus."
          ],
          "nextStep": "Chapitre suivant : « Arrière-plans »."
        },
        {
