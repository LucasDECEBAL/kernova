        {
          "id": "cssl-05",
          "title": "Affichage des éléments",
          "duration": 20,
          "objectives": [
            "Choisir display",
            "Différencier block et inline",
            "Masquer sans casser l'accessibilité"
          ],
          "content": [
            {
              "type": "p",
              "text": "display définit le type de boîte : block, inline, inline-block, flex, grid ou none. Chaque valeur change le flux et les propriétés applicables."
            },
            {
              "type": "table",
              "headers": [
                "Valeur",
                "Comportement"
              ],
              "rows": [
                [
                  "block",
                  "prend toute la largeur"
                ],
                [
                  "inline",
                  "suit le texte, largeur ignorée"
                ],
                [
                  "flex",
                  "enfants alignés sur un axe"
                ],
                [
                  "grid",
                  "grille en deux dimensions"
                ],
                [
                  "none",
                  "retiré du flux et de l'arbre d'accessibilité"
                ]
              ]
            },
            {
              "type": "warning",
              "text": "display: none retire l'élément des lecteurs d'écran ; pour masquer visuellement en gardant l'accessibilité, utilisez une classe de texte hors écran."
            }
          ],
          "exercise": {
            "title": "Choisir display",
            "instructions": "Quel display pour aligner des enfants sur une ligne avec espacement ?",
            "hints": [
