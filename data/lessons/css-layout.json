                "Il anime"
              ],
              "answer": 0,
              "explanation": "Le ratio est conservé.",
              "type": "single",
              "difficulty": 1,
              "hints": [],
              "id": "cssl-04-q2"
            }
          ],
          "summary": [
            "width/height, min/max.",
            "border-box simplifie le calcul.",
            "min-height plutôt que hauteur fixe."
          ],
          "nextStep": "Chapitre suivant : « Affichage des éléments »."
