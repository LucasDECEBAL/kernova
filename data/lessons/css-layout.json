        {
          "id": "cssl-04",
          "title": "Dimensions",
          "duration": 20,
          "objectives": [
            "Définir largeur et hauteur",
            "Utiliser min/max",
            "Comprendre box-sizing"
          ],
          "content": [
            {
              "type": "p",
              "text": "width et height fixent les dimensions ; min- et max- bornent. box-sizing: border-box inclut padding et bordure dans la largeur déclarée."
            },
            {
              "type": "code",
              "lang": "css",
              "code": "* { box-sizing: border-box; }\n.panneau {\n  width: 100%;\n  max-width: 65ch;\n  min-height: 40vh;\n  aspect-ratio: 16 / 9;\n}",
              "title": "Dimensions bornées"
            },
            {
              "type": "warning",
              "text": "Une hauteur fixe en pixels sur un texte flexible provoque des débordements : préférez min-height."
            }
          ],
          "exercise": {
            "title": "Choisir box-sizing",
            "instructions": "Vous voulez que width inclue padding et bordure. Quelle valeur ?",
            "hints": [
              "La boîte inclut tout."
            ],
            "solution": "border-box",
            "check": {
              "type": "keywords",
              "keywords": [
                "border-box"
              ],
              "success": "Correct : border-box."
            }
          },
          "quiz": [
            {
              "question": "Que fait max-width ?",
              "options": [
                "Elle borne la largeur",
                "Elle centre",
                "Elle espace",
                "Elle change la police"
              ],
              "answer": 0,
              "explanation": "La largeur ne dépasse pas la limite.",
              "type": "single",
              "difficulty": 1,
              "hints": [],
              "id": "cssl-04-q1"
            },
            {
              "question": "Que fait aspect-ratio ?",
              "options": [
                "Il fixe un rapport largeur/hauteur",
