          "title": "Rendu côté serveur",
          "duration": 20,
          "objectives": [
            "Comprendre le SSR",
            "Hydrater la page",
            "Gérer les données serveur"
          ],
          "content": [
            {
              "type": "p",
              "text": "En SSR, le HTML est généré sur le serveur puis hydraté côté client. Le premier affichage est plus rapide, mais le serveur travaille à chaque requête."
            },
            {
              "type": "code",
              "lang": "jsx",
              "code": "export default async function Page() {\n  const taches = await chargerTaches();\n  return <Liste elements={taches} />;\n}",
              "title": "Composant serveur"
            },
            {
              "type": "warning",
              "text": "Le SSR n'exécute pas le code navigateur : les API du DOM doivent rester dans des composants client."
            }
          ],
          "exercise": {
            "title": "Hydratation",
            "instructions": "Que fait l'hydratation ?",
            "hints": [
              "Elle rend le HTML interactif."
            ],
            "solution": "Elle attache les gestionnaires React au HTML rendu par le serveur.",
            "check": {
              "type": "keywords",
              "keywords": [
                "hydratation",
                "interactif"
              ],
              "success": "Correct : rendre le HTML interactif."
            }
          },
          "quiz": [
            {
              "question": "Où le HTML est-il généré en SSR ?",
              "options": [
