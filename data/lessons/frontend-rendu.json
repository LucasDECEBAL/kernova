            {
              "type": "code",
              "lang": "jsx",
              "code": "export const revalidate = 3600; // régénère au plus toutes les heures\nexport default async function Page() {\n  return <Liste elements={await charger()} />;\n}",
              "title": "Revalidation"
            },
            {
              "type": "warning",
              "text": "Un contenu très changeant en statique peut être obsolète : prévoyez une revalidation ou un rendu serveur."
            }
          ],
          "exercise": {
