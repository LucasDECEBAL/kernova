        {
          "id": "tss-03",
          "title": "Modules TypeScript",
          "duration": 20,
          "objectives": [
            "Exporter et importer",
            "Choisir le format de module",
            "Éviter les imports circulaires"
          ],
          "content": [
            {
              "type": "p",
              "text": "TypeScript suit les modules ES : export et import, avec des types exportés séparément ou avec export type."
            },
            {
              "type": "code",
              "lang": "ts",
              "code": "// types.ts\nexport type Tache = { id: number };\n\n// app.ts\nimport type { Tache } from \"./types.js\";",
              "title": "Modules"
            },
            {
              "type": "tip",
              "text": "import type garantit que l'import disparaît à la compilation : aucun code inutile n'est chargé."
            }
          ],
          "exercise": {
            "title": "Importer",
            "instructions": "Quel import ne charge que des types ?",
            "hints": [
              "Une forme explicite."
            ],
            "solution": "import type",
            "check": {
              "type": "keywords",
              "keywords": [
                "import type"
              ],
              "success": "Correct : import type."
            }
          },
          "quiz": [
            {
