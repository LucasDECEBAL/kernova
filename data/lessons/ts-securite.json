          "id": "tss-01",
          "title": "Narrowing",
          "duration": 20,
          "objectives": [
            "Affiner un type",
            "Utiliser typeof et in",
            "Éviter les assertions"
          ],
          "content": [
            {
              "type": "p",
              "text": "Le narrowing réduit un type union dans un bloc : typeof, in, instanceof ou un test personnalisé."
            },
            {
              "type": "code",
              "lang": "ts",
              "code": "function afficher(valeur: string | number) {\n  if (typeof valeur === \"string\") {\n    return valeur.toUpperCase();\n  }\n  return valeur.toFixed(2);\n}",
              "title": "typeof"
            },
            {
              "type": "warning",
              "text": "Une assertion as force le type sans vérification : elle peut masquer un bug réel."
            }
          ],
          "exercise": {
            "title": "Affiner",
            "instructions": "Quel opérateur distingue une chaîne d'un nombre ?",
            "hints": [
              "Un opérateur de type."
            ],
            "solution": "typeof",
            "check": {
              "type": "keywords",
              "keywords": [
                "typeof"
              ],
              "success": "Correct : typeof."
            }
          },
          "quiz": [
            {
