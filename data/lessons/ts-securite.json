          "id": "tss-02",
          "title": "Gestion des types nullables",
          "duration": 20,
          "objectives": [
            "Activer strictNullChecks",
            "Vérifier null et undefined",
            "Utiliser les valeurs par défaut"
          ],
          "content": [
            {
              "type": "p",
              "text": "Avec strictNullChecks, null et undefined sont distincts des autres types : il faut les traiter explicitement."
            },
            {
              "type": "code",
              "lang": "ts",
              "code": "function saluer(nom?: string) {\n  const sur = nom ?? \"inconnu\";\n  return \"Bonjour \" + sur;\n}",
              "title": "Valeurs par défaut"
            },
            {
              "type": "warning",
              "text": "L'opérateur ! affirme une non-nullité sans preuve : il déplace l'erreur à l'exécution."
            }
          ],
          "exercise": {
            "title": "Valeur par défaut",
            "instructions": "Quel opérateur remplace null ou undefined par une valeur ?",
            "hints": [
