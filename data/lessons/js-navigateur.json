              ],
              "answer": 0,
              "explanation": "Un seul nœud ou null.",
              "type": "single",
              "difficulty": 1,
              "hints": [],
              "id": "jsn-05-q1"
            },
            {
              "question": "Que faire d'une NodeList ?",
              "options": [
                "La parcourir avec forEach",
                "La convertir en CSS",
                "La chiffrer",
                "La supprimer"
              ],
              "answer": 0,
              "explanation": "Elle est itérable.",
              "type": "single",
              "difficulty": 1,
              "hints": [],
              "id": "jsn-05-q2"
            }
          ],
          "summary": [
            "querySelectorAll pour plusieurs.",
            "classes stables.",
            "NodeList parcourable."
          ],
          "nextStep": "Le parcours est terminé : passez l'évaluation finale pour valider vos acquis."
