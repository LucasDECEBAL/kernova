              "answer": 0,
              "explanation": "mount(\"#app\") par exemple.",
              "type": "single",
              "difficulty": 1,
              "hints": [],
              "id": "fe-01-q2"
            }
          ],
          "summary": [
            "Vue réactif et déclaratif.",
            "createApp.",
            "ref pour l'état."
          ],
          "nextStep": "Chapitre suivant : « Composants Vue »."
