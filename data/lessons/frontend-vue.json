              "answer": 0,
              "explanation": "L'effet est déclenché.",
              "type": "single",
              "difficulty": 1,
              "hints": [],
              "id": "fe-03-q2"
            }
          ],
          "summary": [
            "ref/reactive.",
            "computed pour dériver.",
            "watch pour réagir."
          ],
          "nextStep": "Chapitre suivant : « Introduction à Svelte »."
        },
        {
          "id": "fe-04",
          "title": "Introduction à Svelte",
          "duration": 20,
          "objectives": [
            "Comprendre la compilation",
            "Déclarer un état",
            "Créer un composant"
          ],
          "content": [
            {
              "type": "p",
              "text": "Svelte compile les composants en JavaScript : la réactivité est intégrée au langage, sans DOM virtuel."
            },
            {
              "type": "code",
              "lang": "svelte",
              "code": "<script>\n  let n = 0;\n</script>\n<button on:click={() => n++}>{n}</button>",
              "title": "Composant Svelte"
            },
            {
              "type": "tip",
              "text": "Svelte déplace une partie du travail à la compilation : le bundle est souvent plus léger."
            }
          ],
          "exercise": {
            "title": "Réactivité",
            "instructions": "Comment déclare-t-on un état mutable en Svelte ?",
            "hints": [
