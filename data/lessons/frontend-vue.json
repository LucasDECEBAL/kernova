          "title": "Introduction à Vue.js",
          "duration": 20,
          "objectives": [
            "Comprendre le modèle",
            "Créer une application",
            "Utiliser les templates"
          ],
          "content": [
            {
              "type": "p",
              "text": "Vue combine templates déclaratifs et réactivité. Une application se crée avec createApp et se monte sur un élément."
            },
            {
              "type": "code",
              "lang": "js",
              "code": "import { createApp, ref } from \"vue\";\ncreateApp({\n  setup() {\n    const n = ref(0);\n    return { n };\n  },\n  template: \"<button @click=\\\"n++\\\">{{ n }}</button>\"\n}).mount(\"#app\");",
              "title": "Vue minimal"
            },
            {
              "type": "tip",
              "text": "Vue est progressif : il s'intègre à une page existante ou structure toute l'application."
            }
          ],
          "exercise": {
            "title": "Monter",
            "instructions": "Quelle fonction crée une application Vue ?",
            "hints": [
              "Une fonction d'usine."
            ],
            "solution": "createApp",
            "check": {
              "type": "keywords",
              "keywords": [
                "createapp"
              ],
              "success": "Correct : createApp."
            }
          },
          "quiz": [
            {
              "question": "Que fait ref ?",
              "options": [
                "Il crée une valeur réactive",
                "Il crée un composant",
                "Il monte l'app",
                "Il importe"
              ],
              "answer": 0,
              "explanation": "La valeur déclenche les mises à jour.",
              "type": "single",
              "difficulty": 1,
              "hints": [],
              "id": "fe-01-q1"
            },
            {
              "question": "Où monte-t-on l'application ?",
              "options": [
                "Sur un élément du DOM",
                "Dans le CSS",
                "Dans un cookie",
                "Dans le DNS"
