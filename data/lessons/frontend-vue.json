              "answer": 0,
              "explanation": "La valeur est enveloppée.",
              "type": "single",
              "difficulty": 1,
              "hints": [],
              "id": "fe-03-q1"
            },
            {
              "question": "Que fait watch ?",
              "options": [
                "Il réagit à un changement",
                "Il crée un composant",
