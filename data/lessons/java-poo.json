        {
          "id": "jav-03",
          "title": "Interfaces",
          "duration": 20,
          "objectives": [
            "Déclarer une interface",
            "Implémenter plusieurs interfaces",
            "Utiliser les méthodes par défaut"
          ],
          "content": [
            {
              "type": "p",
              "text": "Une interface décrit un contrat sans état. Une classe peut en implémenter plusieurs ; les méthodes default fournissent un comportement."
            },
            {
              "type": "code",
              "lang": "java",
              "code": "interface Forme { double aire(); }\nclass Carre implements Forme {\n  public double aire() { return 4; }\n}",
              "title": "Implements"
            },
            {
              "type": "p",
              "text": "Une interface se préfère à une classe abstraite quand il n'y a pas de code commun à partager."
            }
          ],
          "exercise": {
            "title": "Implémenter",
            "instructions": "Quel mot-clé implémente une interface ?",
            "hints": [
              "Il respecte le contrat."
            ],
            "solution": "implements",
            "check": {
              "type": "keywords",
              "keywords": [
                "implements"
              ],
              "success": "Correct : implements."
            }
          },
          "quiz": [
            {
