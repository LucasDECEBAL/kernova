          "id": "jav-01",
          "title": "Encapsulation",
          "duration": 20,
          "objectives": [
            "Cacher l'état",
            "Exposer des méthodes",
            "Protéger les invariants"
          ],
          "content": [
            {
              "type": "p",
              "text": "Les champs privés et les méthodes publiques protègent l'état. La validation vit dans la classe, pas chez l'appelant."
            },
            {
              "type": "code",
              "lang": "java",
              "code": "public class Compte {\n  private double solde;\n  public void deposer(double m) {\n    if (m <= 0) throw new IllegalArgumentException();\n    solde += m;\n  }\n}",
              "title": "Invariant"
            },
            {
              "type": "p",
              "text": "Un setter public qui accepte tout annule la protection : validez dans chaque méthode qui modifie l'état."
            }
          ],
          "exercise": {
            "title": "Protéger",
            "instructions": "Où valider un dépôt ?",
            "hints": [
              "Dans la classe."
            ],
            "solution": "Dans la méthode deposer, avant de modifier le solde.",
            "check": {
              "type": "keywords",
              "keywords": [
                "deposer",
                "methode"
              ],
              "success": "Correct : dans la méthode."
            }
          },
          "quiz": [
            {
              "question": "Pourquoi un champ privé ?",
              "options": [
                "Empêcher les modifications directes",
                "Accélérer",
                "Chiffrer",
                "Trier"
              ],
              "answer": 0,
              "explanation": "L'état reste cohérent.",
              "type": "single",
              "difficulty": 1,
              "hints": [],
              "id": "jav-01-q1"
            },
            {
              "question": "Que garantit un invariant ?",
              "options": [
                "Un état toujours valide",
                "La vitesse",
                "Le réseau",
                "Le CSS"
              ],
              "answer": 0,
              "explanation": "Les règles sont vérifiées.",
              "type": "single",
              "difficulty": 1,
              "hints": [],
              "id": "jav-01-q2"
            }
          ],
          "summary": [
            "Champs privés.",
            "Validation interne.",
            "Invariants protégés."
          ],
          "nextStep": "Chapitre suivant : « Héritage »."
