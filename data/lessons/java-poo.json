          "content": [
            {
              "type": "p",
              "text": "Une classe étend une autre et peut redéfinir ses méthodes. @Override vérifie la signature."
            },
            {
              "type": "code",
              "lang": "java",
              "code": "class Animal { void parler() {} }\nclass Chien extends Animal {\n  @Override void parler() { System.out.println(\"Wouf\"); }\n}",
              "title": "extends"
            },
            {
              "type": "p",
              "text": "L'héritage exprime « est un » ; préférez la composition quand la relation n'est pas claire."
            }
          ],
          "exercise": {
            "title": "Redéfinir",
            "instructions": "Quelle annotation vérifie une redéfinition ?",
            "hints": [
              "Une annotation standard."
            ],
            "solution": "@Override",
            "check": {
              "type": "keywords",
              "keywords": [
                "override"
              ],
              "success": "Correct : @Override."
            }
          },
          "quiz": [
