          "title": "Gestion des exceptions",
          "duration": 20,
          "objectives": [
            "Utiliser try/except",
            "Attraper des erreurs précises",
            "Relancer si nécessaire"
          ],
          "content": [
            {
              "type": "p",
              "text": "try protège un bloc ; except cible une erreur précise. Ne capturez pas Exception sans raison : vous masqueriez des bugs."
            },
            {
              "type": "code",
              "lang": "python",
              "code": "try:\n    n = int(saisie)\nexcept ValueError:\n    print(\"Nombre invalide\")",
              "title": "ValueError"
            },
            {
              "type": "warning",
              "text": "Un except: nu attrape aussi les interruptions : précisez le type d'erreur."
            }
          ],
          "exercise": {
            "title": "Cibler",
            "instructions": "Quelle exception pour int(\"abc\") ?",
            "hints": [
              "Une erreur de valeur."
            ],
            "solution": "ValueError",
            "check": {
              "type": "keywords",
              "keywords": [
                "valueerror"
              ],
              "success": "Correct : ValueError."
            }
          },
          "quiz": [
            {
              "question": "Que fait except ValueError ?",
              "options": [
                "Il capture cette erreur précise",
                "Toutes",
                "Aucune",
                "Il relance"
