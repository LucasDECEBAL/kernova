        {
          "id": "pye-02",
          "title": "Modules",
          "duration": 20,
          "objectives": [
            "Importer un module",
            "Créer un module",
            "Éviter les effets de bord"
          ],
          "content": [
            {
              "type": "p",
              "text": "Un module est un fichier .py importable. Le bloc if __name__ == \"__main__\" réserve l'exécution au lancement direct."
            },
            {
              "type": "code",
              "lang": "python",
              "code": "# outils.py\ndef doubler(n):\n    return n * 2\n\n# app.py\nfrom outils import doubler",
              "title": "Module"
            },
            {
              "type": "tip",
              "text": "Un module ne doit rien exécuter à l'import en dehors de définitions : les effets de bord surprennent."
            }
          ],
          "exercise": {
            "title": "Protéger",
            "instructions": "Quelle condition réserve l'exécution au script direct ?",
            "hints": [
              "Une comparaison de __name__."
            ],
            "solution": "if __name__ == \"__main__\":",
            "check": {
              "type": "keywords",
              "keywords": [
                "__name__",
                "__main__"
              ],
              "success": "Correct : __name__ == \"__main__\"."
            }
