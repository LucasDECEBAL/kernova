              "answer": 0,
              "explanation": "Le type est ciblé.",
              "type": "single",
              "difficulty": 1,
              "hints": [],
              "id": "pye-01-q1"
            },
            {
              "question": "Pourquoi éviter except: seul ?",
              "options": [
