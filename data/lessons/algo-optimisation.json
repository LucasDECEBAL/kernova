        {
          "id": "alg8-01",
          "title": "Complexité spatiale",
          "duration": 20,
          "objectives": [
            "Mesurer la mémoire auxiliaire",
            "Comparer tri en place et tri avec copie",
            "Réduire l'empreinte"
          ],
          "content": [
            {
              "type": "p",
              "text": "La complexité spatiale mesure la mémoire supplémentaire utilisée, hors entrée. Un tri en place est O(1) en auxiliaire ; un tri fusion est O(n)."
            },
            {
              "type": "table",
              "headers": [
                "Algorithme",
                "Temps",
                "Espace"
              ],
              "rows": [
                [
                  "Tri sélection",
                  "O(n²)",
                  "O(1)"
                ],
                [
                  "Tri fusion",
                  "O(n log n)",
                  "O(n)"
                ],
                [
                  "Dichotomie",
                  "O(log n)",
                  "O(1)"
                ]
              ]
            },
            {
              "type": "tip",
              "text": "Sur un appareil à mémoire limitée, un algorithme un peu plus lent mais en place peut être le bon choix."
            }
          ],
          "exercise": {
            "title": "Comparer",
            "instructions": "Quel tri utilise le moins de mémoire auxiliaire : sélection ou fusion ?",
            "hints": [
              "L'un trie sur place."
            ],
            "solution": "Le tri par sélection, en O(1).",
            "check": {
              "type": "keywords",
              "keywords": [
                "selection",
                "sélection"
              ],
              "success": "Correct : tri par sélection."
            }
          },
          "quiz": [
            {
              "question": "Que mesure la complexité spatiale ?",
              "options": [
