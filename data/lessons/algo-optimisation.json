          "nextStep": "Chapitre suivant : « Programmation dynamique : introduction »."
        },
        {
          "id": "alg8-03",
          "title": "Programmation dynamique : introduction",
          "duration": 20,
          "objectives": [
            "Identifier des sous-problèmes",
            "Construire une table",
            "Passer de la récursion au tableau"
          ],
          "content": [
            {
              "type": "p",
              "text": "La programmation dynamique résout un problème en combinant des sous-problèmes, en stockant leurs résultats dans une table."
            },
            {
              "type": "code",
              "lang": "text",
              "code": "fib[0] ← 0 ; fib[1] ← 1\nPOUR i DE 2 À n FAIRE\n  fib[i] ← fib[i - 1] + fib[i - 2]\nRETOURNER fib[n]",
              "title": "Fibonacci itératif"
            },
            {
              "type": "p",
              "text": "Deux conditions : des sous-problèmes qui se répètent et une structure optimale (la solution se construit à partir des sous-solutions)."
            },
            {
              "type": "tip",
              "text": "Commencez par écrire la récurrence, puis la version tabulée : la seconde évite la récursion profonde."
            }
          ],
          "exercise": {
            "title": "Écrire la récurrence",
            "instructions": "Donnez la relation qui définit fib(n).",
            "hints": [
              "Chaque terme dépend des deux précédents."
            ],
            "solution": "fib(n) = fib(n − 1) + fib(n − 2), avec fib(0) = 0 et fib(1) = 1.",
            "check": {
              "type": "keywords",
              "keywords": [
                "fib(n - 1)",
                "fib(n-1)",
                "n - 1"
              ],
              "success": "Correct : somme des deux précédents."
            }
          },
          "quiz": [
