        {
          "id": "alg8-02",
          "title": "Mémoïsation",
          "duration": 20,
          "objectives": [
            "Reconnaître un calcul répété",
            "Mettre en cache un résultat",
            "Mesurer le gain"
          ],
          "content": [
            {
              "type": "p",
              "text": "La mémoïsation conserve les résultats déjà calculés pour éviter de les recalculer. Elle transforme une récursion exponentielle en calcul linéaire."
            },
            {
              "type": "code",
              "lang": "text",
              "code": "cache ← {}\nFONCTION fib(n)\n  SI n DANS cache ALORS RETOURNER cache[n]\n  SI n ≤ 1 ALORS RETOURNER n\n  cache[n] ← fib(n - 1) + fib(n - 2)\n  RETOURNER cache[n]",
              "title": "Fibonacci mémoïsé"
            },
            {
              "type": "warning",
              "text": "Le cache consomme de la mémoire : sur de très grandes entrées, il faut borner sa taille ou choisir une autre approche."
            }
          ],
          "exercise": {
            "title": "Expliquer le gain",
            "instructions": "Pourquoi fib(30) devient-il rapide avec un cache ?",
            "hints": [
              "Sans cache, les mêmes sous-problèmes sont recalculés."
            ],
            "solution": "Chaque valeur est calculée une fois puis relue dans le cache, au lieu d'être recalculée des millions de fois.",
            "check": {
              "type": "keywords",
              "keywords": [
                "cache",
                "recalcul"
              ],
              "success": "Correct : résultats réutilisés."
            }
          },
          "quiz": [
            {
              "question": "Que stocke la mémoïsation ?",
              "options": [
                "Les résultats déjà calculés",
                "Les entrées brutes",
                "Le code source",
                "Les erreurs"
              ],
              "answer": 0,
              "explanation": "Le cache évite les recalculs.",
              "type": "single",
              "difficulty": 1,
              "hints": [],
              "id": "alg8-02-q1"
            },
            {
              "question": "Quel est le compromis ?",
