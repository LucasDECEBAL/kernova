              "answer": 0,
              "explanation": "Le cache occupe de la mémoire.",
              "type": "single",
              "difficulty": 1,
              "hints": [],
              "id": "alg8-02-q2"
            }
          ],
          "summary": [
            "Mémoïsation = cache de résultats.",
            "Évite les recalculs.",
