            {
              "question": "Que valide Pydantic ?",
              "options": [
                "La forme des données",
                "Les droits",
                "Le réseau",
                "Le disque"
              ],
              "answer": 0,
              "explanation": "Les types sont contrôlés.",
              "type": "single",
              "difficulty": 1,
              "hints": [],
              "id": "pyw-01-q2"
            }
          ],
          "summary": [
            "FastAPI + Pydantic.",
            "Validation de forme.",
            "OpenAPI."
          ],
          "nextStep": "Chapitre suivant : « Introduction à Django »."
