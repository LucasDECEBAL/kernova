          "id": "pyw-01",
          "title": "Introduction à FastAPI",
          "duration": 20,
          "objectives": [
            "Déclarer une route",
            "Typer les données",
            "Documenter automatiquement"
          ],
          "content": [
            {
              "type": "p",
              "text": "FastAPI déclare des routes et des modèles typés ; la validation et la documentation OpenAPI sont générées."
            },
            {
              "type": "code",
              "lang": "python",
              "code": "from fastapi import FastAPI\nfrom pydantic import BaseModel\n\napp = FastAPI()\n\nclass Tache(BaseModel):\n    titre: str\n\n@app.post(\"/taches\")\ndef creer(tache: Tache):\n    return tache",
              "title": "FastAPI"
            },
            {
              "type": "warning",
              "text": "Le typage valide la forme, pas les règles métier : vérifiez la longueur, les droits et les doublons."
            }
          ],
          "exercise": {
            "title": "Typer",
            "instructions": "Quel outil valide le corps d'une requête FastAPI ?",
            "hints": [
              "Un modèle."
            ],
            "solution": "Un modèle Pydantic (BaseModel).",
            "check": {
              "type": "keywords",
              "keywords": [
                "pydantic",
                "basemodel"
              ],
              "success": "Correct : modèle Pydantic."
            }
          },
          "quiz": [
            {
              "question": "Que génère FastAPI ?",
              "options": [
                "Une documentation OpenAPI",
                "Un CSS",
                "Un DNS",
                "Un cookie"
