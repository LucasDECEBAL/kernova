              "type": "code",
              "lang": "php",
              "code": "session_start();\n$_SESSION[\"panier\"][] = $produitId;\nsetcookie(\"theme\", \"sombre\", [\"httponly\" => true, \"samesite\" => \"Lax\"]);",
              "title": "Session"
            },
            {
              "type": "p",
              "text": "Régénérez l'identifiant après connexion pour limiter la fixation de session."
