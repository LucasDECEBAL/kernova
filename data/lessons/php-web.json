              "type": "code",
              "lang": "php",
              "code": "$email = filter_input(INPUT_POST, \"email\", FILTER_VALIDATE_EMAIL);\nif (!$email) { $erreur = \"Adresse invalide\"; }\necho htmlspecialchars($email ?? \"\", ENT_QUOTES, \"UTF-8\");",
              "title": "Validation"
            },
            {
              "type": "p",
              "text": "Ne faites jamais confiance à $_POST : validez, puis échappez selon le contexte (HTML, SQL, URL)."
            }
