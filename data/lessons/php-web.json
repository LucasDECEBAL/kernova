          "content": [
            {
              "type": "p",
              "text": "Les tableaux PHP sont ordonnés et associent clés et valeurs. array_map, array_filter et array_sum couvrent l'essentiel."
            },
            {
              "type": "code",
              "lang": "php",
              "code": "$notes = [\"ada\" => 15, \"linus\" => 12];\nforeach ($notes as $nom => $note) {\n    echo \"$nom : $note\";\n}",
              "title": "Tableau associatif"
            },
            {
              "type": "p",
              "text": "Un tableau non déclaré vaut null : initialisez-le avant d'ajouter des éléments."
            }
          ],
          "exercise": {
            "title": "Parcourir",
            "instructions": "Parcourez $notes en affichant clé et valeur.",
            "hints": [
              "foreach avec clé."
