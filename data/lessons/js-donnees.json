        {
          "id": "jsd-03",
          "title": "Dates et heures",
          "duration": 20,
          "objectives": [
            "Créer une date",
            "Formater pour l'affichage",
            "Calculer une différence"
          ],
          "content": [
            {
              "type": "p",
              "text": "Date représente un instant. toISOString donne un format international ; les opérations se font en millisecondes."
            },
            {
              "type": "code",
              "lang": "js",
              "code": "const debut = new Date(\"2026-01-01T00:00:00Z\");\nconst fin = new Date();\nconst jours = Math.round((fin - debut) / 86400000);\nfin.toLocaleDateString(\"fr-FR\");",
              "title": "Dates"
            },
            {
              "type": "warning",
              "text": "new Date(\"2026-01-01\") est interprété en UTC : pour un jour local, précisez l'heure ou construisez avec année, mois, jour."
            }
          ],
          "exercise": {
            "title": "Calculer",
            "instructions": "Combien de millisecondes dans une journée ?",
            "hints": [
              "Secondes × minutes × heures."
            ],
            "solution": "86 400 000",
            "check": {
