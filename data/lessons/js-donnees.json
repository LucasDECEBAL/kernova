        {
          "id": "jsd-05",
          "title": "Portée et closures",
          "duration": 20,
          "objectives": [
            "Comprendre la portée",
            "Reconnaître une closure",
            "Éviter les fuites"
          ],
          "content": [
            {
              "type": "p",
              "text": "Une closure est une fonction qui retient les variables de son contexte de création, même après la fin de ce contexte."
            },
            {
              "type": "code",
              "lang": "js",
              "code": "function compteur() {\n  let n = 0;\n  return () => ++n;\n}\nconst suivant = compteur();\nsuivant(); // 1\nsuivant(); // 2",
              "title": "Closure"
            },
            {
              "type": "warning",
              "text": "Une closure qui capture un gros objet le garde en mémoire : attention aux fuites dans les gestionnaires d'événements."
            }
          ],
          "exercise": {
            "title": "Reconnaître",
            "instructions": "Que retient la fonction renvoyée par compteur ?",
            "hints": [
              "La variable de son contexte."
            ],
            "solution": "La variable n, capturée dans la closure.",
            "check": {
