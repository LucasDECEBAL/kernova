              "type": "code",
              "lang": "js",
              "code": "const titre = \"  Les Bases de JS  \";\ntitre.trim().toLowerCase().includes(\"js\"); // true\ntitre.trim().split(\" \"); // [\"Les\",\"Bases\",\"de\",\"JS\"]",
              "title": "Chaînes"
            },
            {
              "type": "warning",
              "text": "Les chaînes sont immuables : replace renvoie une nouvelle chaîne, il ne modifie pas l'originale."
            }
          ],
          "exercise": {
            "title": "Comparer",
            "instructions": "Comparez deux chaînes sans tenir compte de la casse.",
