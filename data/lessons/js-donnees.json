        {
          "id": "jsd-04",
          "title": "Conversion des types",
          "duration": 20,
          "objectives": [
            "Convertir en nombre",
            "Convertir en chaîne",
            "Éviter les conversions implicites"
          ],
          "content": [
            {
              "type": "p",
              "text": "Number(), String() et Boolean() convertissent explicitement. parseInt/parseFloat lisent un préfixe numérique."
            },
            {
              "type": "code",
              "lang": "js",
              "code": "Number(\"42\")     // 42\nNumber(\"42px\")   // NaN\nparseInt(\"42px\") // 42\nString(42)       // \"42\"\nBoolean(\"\")      // false",
              "title": "Conversions"
            },
            {
              "type": "warning",
              "text": "NaN est un number : testez avec Number.isNaN(), pas avec === NaN."
            }
          ],
          "exercise": {
            "title": "Convertir",
            "instructions": "Convertissez la chaîne \"42\" en nombre.",
            "hints": [
              "Une fonction globale."
            ],
            "solution": "Number(\"42\")",
            "check": {
              "type": "keywords",
              "keywords": [
                "number("
              ],
              "success": "Correct : Number."
            }
          },
          "quiz": [
