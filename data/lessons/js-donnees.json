      "title": "Tableaux, chaînes et portée",
      "chapters": [
        {
          "id": "jsd-01",
          "title": "Méthodes des tableaux",
          "duration": 20,
          "objectives": [
            "Utiliser map, filter, reduce",
            "Chaîner les méthodes",
            "Éviter les mutations inutiles"
          ],
          "content": [
            {
              "type": "p",
              "text": "map transforme, filter garde, reduce agrège. Ces méthodes renvoient un nouveau tableau ou une valeur sans modifier l'original."
            },
            {
              "type": "code",
              "lang": "js",
              "code": "const notes = [8, 12, 17, 9, 15];\nconst doubles = notes.filter((n) => n >= 10).map((n) => n * 2);\n// [24, 34, 30]",
              "title": "Chaînage"
            },
            {
              "type": "warning",
              "text": "forEach ne renvoie rien : pour construire un résultat, utilisez map, filter ou reduce."
            }
          ],
          "exercise": {
            "title": "Filtrer et transformer",
            "instructions": "Gardez les notes ≥ 10 puis multipliez-les par 2.",
            "hints": [
              "filter puis map."
            ],
            "solution": "notes.filter((n) => n >= 10).map((n) => n * 2)",
            "check": {
              "type": "any",
              "any": [
                "[24, 34, 30]",
                "24, 34, 30",
                "24,34,30"
              ],
              "success": "Correct : [24, 34, 30]."
            }
          },
          "quiz": [
            {
              "question": "Que fait filter ?",
              "options": [
                "Il garde les éléments qui passent le test",
                "Il transforme",
                "Il agrège",
                "Il trie"
              ],
              "answer": 0,
              "explanation": "Un nouveau tableau est renvoyé.",
              "type": "single",
              "difficulty": 1,
              "hints": [],
              "id": "jsd-01-q1"
            },
            {
              "question": "Que fait reduce ?",
              "options": [
                "Il agrège en une valeur",
                "Il filtre",
                "Il ajoute à la fin",
                "Il supprime"
              ],
              "answer": 0,
              "explanation": "Il réduit le tableau.",
              "type": "single",
              "difficulty": 1,
              "hints": [],
              "id": "jsd-01-q2"
            }
          ],
          "summary": [
            "map, filter, reduce.",
            "Chaînage lisible.",
            "Pas de mutation inutile."
          ],
          "nextStep": "Chapitre suivant : « Manipulation des chaînes »."
        },
        {
          "id": "jsd-02",
          "title": "Manipulation des chaînes",
          "duration": 20,
          "objectives": [
