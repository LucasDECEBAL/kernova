                  "fenêtre",
                  "barre de défilement"
                ]
              ]
            },
            {
              "type": "tip",
              "text": "Pour la typographie et les espacements, rem est prévisible ; gardez une largeur de ligne entre 55 et 75 caractères (ch)."
            }
          ],
          "exercise": {
            "title": "Choisir une unité",
            "instructions": "Quelle unité pour une taille de texte indépendante du parent ?",
